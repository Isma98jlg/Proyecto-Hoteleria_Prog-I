@page
@model Hoteleria_App.Pages.Reservas.EditarModel
@using Hoteleria_App.Models
@{
    ViewData["Title"] = "Editar Reserva";
}

<div class="flex flex-col gap-6 w-full max-w-4xl">

    <!-- ==================== SUB-HEADER ==================== -->
    <section class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-4 md:p-5 shadow-sm flex flex-col gap-4">
        <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-5">
            <div class="flex flex-col gap-1.5">
                <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-bold">Reservas · Edición</span>
                <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Editar Reserva #@Model.Detalle?.ReservaId</h1>
                <p class="font-body-md text-body-md text-on-surface-variant">Modifique el estado y, antes del check-in, las fechas o habitaciones.</p>
            </div>
            <div class="flex items-center gap-2">
                <a class="flex items-center gap-2 px-4 py-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-body-sm text-body-sm transition-all shadow-sm" asp-page="Detalles" asp-route-id="@Model.Detalle?.ReservaId">
                    <span class="material-symbols-outlined text-[18px]">visibility</span>
                    <span>Ver detalle</span>
                </a>
                <a class="flex items-center gap-2 px-4 py-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-body-sm text-body-sm transition-all shadow-sm" asp-page="Index">
                    <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                    <span>Volver al listado</span>
                </a>
            </div>
        </div>
    </section>

    @if (Model.Detalle is null)
    {
        <div class="bg-error-container text-on-error-container rounded-2xl p-8 text-center">
            <span class="material-symbols-outlined text-[40px] text-on-error-container block mb-3">error</span>
            <h2 class="font-headline-sm text-headline-sm text-on-error-container">Reserva no encontrada</h2>
            <a class="px-4 py-2 rounded-lg bg-primary text-on-primary font-body-sm text-body-sm font-semibold" asp-page="Index">Volver al listado</a>
        </div>
    }
    else
    {
        <form method="post" class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-6 shadow-sm flex flex-col gap-6">
            <div asp-validation-summary="ModelOnly" class="rounded-xl bg-error-container text-on-error-container p-3"></div>
            <!-- Estado -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-1 flex flex-col gap-4">
                    <div class="flex items-center justify-between p-3 rounded-xl bg-surface-container-low border border-surface-container">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-xl bg-primary-container flex items-center justify-center text-on-primary">
                                <span class="material-symbols-outlined text-[18px]">flag</span>
                            </div>
                            <div>
                                <span class="font-label-sm text-label-sm font-bold uppercase tracking-wider text-on-surface">Estado de Reserva</span>
                                <span class="font-label-sm text-[10px] text-outline">Cambie el estado actual de la estancia</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex flex-col gap-3">
                        <label class="font-label-sm text-label-sm text-on-surface-variant">Estado</label>
                        <select asp-for="Reserva.EstadoReserva" asp-items="@(Model.Estados.Select(e => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem(EstadosReserva.Etiqueta(e), e)))"
                                class="w-full px-3 py-2 bg-surface-container-low rounded-xl text-on-surface font-body-sm text-body-sm focus:outline-none">
                        </select>
                        <span asp-validation-for="Reserva.EstadoReserva" class="text-label-sm text-error"></span>
                    </div>
                    @if (EstadosReserva.Editable(Model.Detalle.EstadoReserva))
                    {
                        <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">Check-in<input asp-for="Reserva.InicioReserva" type="date" class="w-full px-3 py-2 bg-surface-container-low rounded-xl text-on-surface font-body-sm text-body-sm" /></label>
                        <label class="flex flex-col gap-1 font-label-sm text-label-sm text-on-surface-variant">Noches<input asp-for="Reserva.TotalNoches" type="number" min="1" max="365" class="w-full px-3 py-2 bg-surface-container-low rounded-xl text-on-surface font-body-sm text-body-sm" /><span asp-validation-for="Reserva.TotalNoches" class="text-error"></span></label>
                    }
                </div>

                <!-- Habitaciones asignadas (solo lectura) -->
                <div class="lg:col-span-2 flex flex-col gap-4">
                    <div class="flex items-center justify-between p-3 rounded-xl bg-surface-container-low border border-surface-container">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-xl bg-secondary-fixed flex items-center justify-center text-secondary">
                                <span class="material-symbols-outlined text-[18px]">meeting_room</span>
                            </div>
                            <div>
                                <span class="font-label-sm text-label-sm font-bold uppercase tracking-wider text-on-surface">Habitaciones Asignadas (@Model.Detalle.Habitaciones.Count)</span>
                                <span class="font-label-sm text-[10px] text-outline">Habitaciones vinculadas a esta reserva</span>
                            </div>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead class="bg-surface-container-low font-label-md text-label-md text-outline uppercase tracking-wider">
                                <tr>
                                    <th class="py-3 px-4">Código</th>
                                    <th class="py-3 px-4">Tipo</th>
                                    <th class="py-3 px-4">Camas</th>
                                    <th class="py-3 px-4 text-right">Precio Noche</th>
                                    <th class="py-3 px-4 text-right">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-surface-container font-body-sm text-body-sm">
                                @foreach (var h in Model.Detalle.Habitaciones)
                                {
                                    <tr class="hover:bg-surface-container-low/60 transition-colors">
                                        <td class="py-3 px-4 font-mono text-on-surface">@h.CodigoHabitacion</td>
                                        <td class="py-3 px-4 text-on-surface-variant">@h.TipoVip</td>
                                        <td class="py-3 px-4 text-on-surface">@h.NroCamas</td>
                                        <td class="py-3 px-4 text-right text-on-surface">$@h.PrecioNochePactado.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</td>
                                        <td class="py-3 px-4 text-right font-numeric-table text-numeric-table font-bold text-on-surface">$@((h.PrecioNochePactado * Model.Detalle.TotalNoches).ToString("N0", System.Globalization.CultureInfo.InvariantCulture))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (EstadosReserva.Editable(Model.Detalle.EstadoReserva))
                    {
                        <fieldset class="flex flex-col gap-2 rounded-xl border border-surface-container-high p-3">
                            <legend class="px-1 font-label-sm text-label-sm text-on-surface-variant">Habitaciones de la reserva (las fechas se revisan al guardar)</legend>
                            @foreach (var h in Model.Detalle.Habitaciones)
                            {
                                <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="Reserva.HabitacionIds" value="@h.HabitacionId" checked class="h-4 w-4 accent-primary" />@h.CodigoHabitacion · @h.TipoVip · @h.Ubicacion · $@h.PrecioNochePactado.ToString("N0") / noche</label>
                            }
                            @foreach (var h in Model.OtrasHabitaciones)
                            {
                                <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="Reserva.HabitacionIds" value="@h.HabitacionId" class="h-4 w-4 accent-primary" />@h.Codigo · @h.TipoVip · @h.Ubicacion · $@h.PrecioNoche.ToString("N0") / noche</label>
                            }
                        </fieldset>
                    }
                    <div class="mt-2 text-right">
                        <span class="font-body-sm text-body-sm font-bold text-on-surface">Total de la reserva: </span>
                        <span class="font-body-sm text-body-sm font-mono text-on-surface">$@Model.Detalle.PrecioTotal.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span>
                    </div>
                </div>
            </div>

            <div class="border-t border-surface-container-high pt-4 flex items-center justify-between">
                <a class="flex items-center gap-2 px-4 py-2 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-body-sm text-body-sm transition-colors" asp-page="Index">
                    <span class="material-symbols-outlined text-[16px]">cancel</span>
                    <span>Cancelar</span>
                </a>
                <button type="submit" class="px-6 py-2.5 rounded-lg bg-primary hover:bg-on-surface-variant text-on-primary font-body-sm text-body-sm font-semibold transition-all shadow-md">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    <span>Guardar Cambios</span>
                </button>
            </div>

            <!-- Eliminar (solo si está PENDIENTE) -->
        </form>
            @if (Model.Detalle.EstadoReserva == "PENDIENTE")
            {
                <div class="border-t border-surface-container-high pt-4 flex items-center justify-end">
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@Model.Detalle.ReservaId" onsubmit="return confirm('¿Está seguro de eliminar esta reserva? Esta acción no se puede deshacer.')" class="inline">
                        <button type="submit" class="px-4 py-2 rounded-lg bg-error-container hover:bg-error text-on-error hover:text-on-error-container font-body-sm text-body-sm transition-colors">
                            <span class="material-symbols-outlined text-[18px]">delete</span>
                            <span>Eliminar Reserva</span>
                        </button>
                    </form>
                </div>
            }
    }

</div>
