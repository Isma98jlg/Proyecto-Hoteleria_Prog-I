@page
@model Hoteleria_App.Pages.Reservas.IndexModel
@{
    ViewData["Title"] = "Gestión de Reservas";
}

<div class="flex flex-col gap-6 w-full">

    <!-- ==================== SUB-HEADER ==================== -->
    <section class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-4 md:p-5 shadow-sm flex flex-col gap-4">
        <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-5">
            <div class="flex flex-col gap-1.5">
                <div class="flex items-center gap-2">
                    <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-bold">Reservas</span>
                    <span class="font-label-sm text-label-sm text-outline flex items-center gap-1">
                        <span class="inline-block w-1.5 h-1.5 rounded-full bg-on-tertiary-container"></span> Se actualiza en tiempo real
                    </span>
                </div>
                <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Libro de reservas</h1>
                <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl">Crear, editar y consultar reservas de huéspedes, asignar habitaciones y gestionar estados de estancia (Confirmada, En curso, Finalizada, Cancelada).</p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <button type="button" onclick="abrirModalReserva()" class="flex items-center gap-2 px-5 py-2.5 rounded-lg bg-primary hover:bg-on-surface-variant text-on-primary font-body-sm text-body-sm font-semibold transition-all shadow-md group">
                    <span class="material-symbols-outlined text-[20px] text-secondary-container transition-transform group-hover:rotate-45">calendar_month</span>
                    <span>+ Nueva Reserva</span>
                </button>
                <a class="flex items-center gap-2 px-3.5 py-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-body-sm text-body-sm transition-all shadow-sm" asp-page="Index">
                    <span class="material-symbols-outlined text-[19px]">refresh</span>
                    <span>Actualizar</span>
                </a>
            </div>
        </div>
    </section>

    <!-- ==================== FILTROS ==================== -->
    <form method="get" class="bg-surface-container-lowest border border-surface-container-high p-4 rounded-2xl shadow-sm flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
        <div class="flex-1 flex flex-wrap sm:flex-nowrap items-center gap-3">
            <div class="relative flex-1 min-w-[220px]">
                <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">search</span>
                <input class="w-full pl-10 pr-4 py-2 bg-surface-container-low rounded-xl text-on-surface font-body-sm text-body-sm placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest shadow-inner" name="Buscar" value="@Model.Buscar" placeholder="Buscar huésped por nombre..." type="text">
            </div>
            <div class="min-w-[200px]">
                <select class="w-full px-3 py-2 bg-surface-container-low rounded-xl text-on-surface font-body-sm text-body-sm focus:outline-none font-medium" name="Estado">
                    <option value="">Todos los Estados</option>
                    @foreach (var e in Model.Estados)
                    {
                        <option value="@e" selected="@(Model.Estado == e)">@EstadosReserva.Etiqueta(e)</option>
                    }
                </select>
            </div>
            <div class="min-w-[220px]">
                <select class="w-full px-3 py-2 bg-surface-container-low rounded-xl text-on-surface font-body-sm text-body-sm focus:outline-none font-medium" name="UsuarioId">
                    <option value="">Todos los Huéspedes</option>
                    @foreach (var u in Model.Usuarios)
                    {
                        <option value="@u.UsuarioId" selected="@(Model.UsuarioId == u.UsuarioId)">@u.NombreCompleto · @u.Documento</option>
                    }
                </select>
            </div>
        </div>
        <div class="flex items-center gap-3 justify-end shrink-0">
            <span class="font-label-sm text-label-sm text-outline">@(Model.Total == 0 ? "Sin reservas" : $"{(Model.Pagina - 1) * Hoteleria_App.Pages.Reservas.IndexModel.TamanoPagina + 1}–{(Model.Pagina - 1) * Hoteleria_App.Pages.Reservas.IndexModel.TamanoPagina + Model.Reservas.Count} de {Model.Total} reservas")</span>
            <button class="px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-variant text-on-surface-variant font-label-sm text-label-sm transition-colors" type="submit">Aplicar</button>
            <a class="px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-variant text-on-surface-variant font-label-sm text-label-sm transition-colors" asp-page="Index">Limpiar Filtros</a>
        </div>
    </form>

    <!-- ==================== LISTADO DE RESERVAS ==================== -->
    <div class="bg-surface-container-lowest border border-surface-container-high rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="bg-surface-container-low font-label-md text-label-md text-outline uppercase tracking-wider sticky top-0 z-10">
                    <tr>
                        <th class="py-3 px-4">N° Reserva</th>
                        <th class="py-3 px-4">Huésped</th>
                        <th class="py-3 px-4">Documento</th>
                        <th class="py-3 px-4">Estado</th>
                        <th class="py-3 px-4">Check-in</th>
                        <th class="py-3 px-4">Check-out</th>
                        <th class="py-3 px-4">Noches</th>
                        <th class="py-3 px-4">Habitaciones</th>
                        <th class="py-3 px-4">Precio Total</th>
                        <th class="py-3 px-4 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container font-body-sm text-body-sm">
                    @if (!Model.Reservas.Any())
                    {
                        <tr>
                            <td colspan="10" class="py-10 text-center">
                                <span class="material-symbols-outlined text-[40px] text-outline">calendar_month</span>
                                <span class="font-headline-sm text-headline-sm text-on-surface block mt-2">Sin reservas que coincidan</span>
                                <span class="font-body-sm text-body-sm text-on-surface-variant">Ajusta los filtros o crea una nueva reserva.</span>
                            </td>
                        </tr>
                    }
                    @foreach (var r in Model.Reservas)
                    {
                        <tr class="hover:bg-surface-container-low/60 transition-colors group">
                            <td class="py-3 px-4 font-headline-sm text-headline-sm text-on-surface font-mono">#@r.ReservaId</td>
                            <td class="py-3 px-4">
                                <div class="flex flex-col">
                                    <span class="font-semibold text-on-surface">@r.UsuarioNombre</span>
                                    <span class="font-label-sm text-[11px] text-outline">@r.UsuarioDocumento</span>
                                </div>
                            </td>
                            <td class="py-3 px-4 text-on-surface-variant">@r.UsuarioDocumento</td>
                            <td class="py-3 px-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full @r.BadgeEstado font-label-sm text-label-sm font-semibold"><span class="w-2 h-2 rounded-full @(r.EstadoReserva == "CONFIRMADA" ? "bg-secondary" : r.EstadoReserva == "FINALIZADA" ? "bg-on-tertiary-container" : "bg-error")"></span>@r.EstadoEtiqueta</span>
                            </td>
                            <td class="py-3 px-4 text-on-surface">@r.InicioReserva.ToString("dd/MM/yyyy")</td>
                            <td class="py-3 px-4 text-on-surface">@r.FinReserva.ToString("dd/MM/yyyy")</td>
                            <td class="py-3 px-4 font-numeric-table text-numeric-table text-on-surface">@r.TotalNoches</td>
                            <td class="py-3 px-4 text-on-surface">@r.TotalHabitaciones</td>
                            <td class="py-3 px-4 font-numeric-table text-numeric-table font-bold text-on-surface">@Soles.Formatear(r.PrecioTotal)</td>
                            <td class="py-3 px-4 text-right">
                                <div class="flex items-center gap-1.5">
                                    <a class="p-2 rounded hover:bg-surface-container-low text-outline hover:text-on-surface transition-colors" asp-page="Detalles" asp-route-id="@r.ReservaId" title="Ver detalle">
                                        <span class="material-symbols-outlined text-[18px]">visibility</span>
                                    </a>
                                    <a class="p-2 rounded hover:bg-surface-container-low text-outline hover:text-on-surface transition-colors" asp-page="Editar" asp-route-id="@r.ReservaId" title="Editar reserva">
                                        <span class="material-symbols-outlined text-[18px]">edit</span>
                                    </a>
                                    @if (r.EstadoReserva == "PENDIENTE")
                                    {
                                        <form method="post" asp-page-handler="Eliminar" asp-route-id="@r.ReservaId" onsubmit="return confirm('¿Está seguro de eliminar esta reserva?')" class="inline">
                                            <button class="p-2 rounded hover:bg-error-container text-error hover:text-on-error transition-colors" type="submit" title="Eliminar reserva">
                                                <span class="material-symbols-outlined text-[18px]">delete</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPaginas > 1)
        {
            <nav class="flex flex-wrap items-center justify-between gap-3 border-t border-surface-container-high px-4 py-3" aria-label="Páginas del libro de reservas">
                <span class="font-label-sm text-label-sm text-outline">Página @Model.Pagina de @Model.TotalPaginas</span>
                <div class="flex items-center gap-2">
                    @if (Model.Pagina > 1)
                    {
                        <a asp-page="Index" asp-route-Buscar="@Model.Buscar" asp-route-Estado="@Model.Estado" asp-route-UsuarioId="@Model.UsuarioId" asp-route-Pagina="@(Model.Pagina - 1)" class="flex items-center gap-1 rounded-lg bg-surface-container px-3 py-1.5 font-label-sm text-label-sm text-on-surface hover:bg-surface-container-high"><span class="material-symbols-outlined text-[16px]">chevron_left</span>Anterior</a>
                    }
                    @if (Model.Pagina < Model.TotalPaginas)
                    {
                        <a asp-page="Index" asp-route-Buscar="@Model.Buscar" asp-route-Estado="@Model.Estado" asp-route-UsuarioId="@Model.UsuarioId" asp-route-Pagina="@(Model.Pagina + 1)" class="flex items-center gap-1 rounded-lg bg-primary px-3 py-1.5 font-label-sm text-label-sm text-on-primary hover:opacity-90">Siguiente<span class="material-symbols-outlined text-[16px]">chevron_right</span></a>
                    }
                </div>
            </nav>
        }
    </div>

</div>

<div id="reservationModal" class="fixed inset-0 z-50 hidden items-center justify-center overflow-y-auto bg-primary/50 p-3 backdrop-blur-sm md:p-6" role="dialog" aria-modal="true" aria-labelledby="reservationModalTitle" onclick="if(event.target===this) cerrarModalReserva()">
    <section class="my-auto flex max-h-[92vh] w-full max-w-4xl flex-col overflow-hidden rounded-2xl border border-surface-container-high bg-surface-container-lowest shadow-2xl">
        <header class="flex shrink-0 items-center justify-between gap-4 border-b border-surface-container-high bg-surface-container-low/60 px-5 py-4 md:px-6">
            <div class="flex min-w-0 items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary text-on-primary"><span class="material-symbols-outlined">calendar_add_on</span></span>
                <div class="min-w-0">
                    <div class="flex flex-wrap items-baseline gap-x-2">
                        <h2 id="reservationModalTitle" class="font-headline-md text-headline-md text-on-surface">Crear nueva reserva</h2>
                        <span class="text-xs text-outline">GrandStay HMS</span>
                    </div>
                    <p class="mt-1 flex items-center gap-1.5 text-xs text-on-surface-variant"><span class="material-symbols-outlined text-[15px] text-on-tertiary-container">schedule</span>Fecha de registro automática al guardar</p>
                </div>
            </div>
            <button type="button" onclick="cerrarModalReserva()" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-outline transition-colors hover:bg-surface-container hover:text-on-surface" aria-label="Cerrar">
                <span class="material-symbols-outlined">close</span>
            </button>
        </header>
        <form method="post" asp-page-handler="Crear" id="reservation-form" class="flex min-h-0 flex-1 flex-col">
            <div class="flex-1 space-y-4 overflow-y-auto bg-background p-4 md:p-5">
                <div asp-validation-summary="ModelOnly" class="rounded-xl border border-error/20 bg-error-container p-3 text-sm text-on-error-container"></div>

                <section class="flex flex-col gap-3 rounded-xl border border-surface-container-high bg-surface-container-low/50 p-4">
                    <div class="flex items-center gap-2.5">
                        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary text-xs font-bold text-on-primary">1</span>
                        <h3 class="text-xs font-bold uppercase tracking-wider text-on-surface">Usuario titular</h3>
                    </div>
                    <div class="grid grid-cols-1 items-end gap-3 md:grid-cols-12">
                        <label class="flex flex-col gap-1.5 md:col-span-7">
                            <span class="text-xs font-medium text-on-surface">Buscar usuario registrado <span class="text-error">*</span></span>
                            <select asp-for="Reserva.UsuarioId" id="reservation-user" class="w-full rounded-lg border border-outline-variant/60 bg-surface-container-lowest px-3 py-2.5 text-sm text-on-surface shadow-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary">
                                <option value="0">Seleccione un usuario</option>
                                @foreach (var u in Model.Usuarios)
                                {
                                    <option value="@u.UsuarioId" data-name="@u.NombreCompleto" data-role="@u.Documento">@u.NombreCompleto · @u.Documento</option>
                                }
                            </select>
                            <span asp-validation-for="Reserva.UsuarioId" class="text-xs text-error"></span>
                        </label>
                        <div id="selected-user-summary" class="flex min-h-[50px] items-center gap-3 rounded-lg border border-surface-container-high bg-surface-container-lowest px-3 py-2 md:col-span-5">
                            <span id="selected-user-initials" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-secondary-fixed text-xs font-bold text-on-secondary-fixed">—</span>
                            <span class="flex min-w-0 flex-col"><strong id="selected-user-name" class="truncate text-sm font-semibold text-on-surface">Sin usuario seleccionado</strong><small id="selected-user-role" class="text-xs text-outline">Usuario titular</small></span>
                        </div>
                    </div>
                </section>

                <section class="flex flex-col gap-3 rounded-xl border border-surface-container-high bg-surface-container-low/50 p-4">
                    <div class="flex items-center gap-2.5">
                        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary text-xs font-bold text-on-primary">2</span>
                        <div><h3 class="text-xs font-bold uppercase tracking-wider text-on-surface">Fechas y estancia</h3><p class="text-xs text-outline">Las fechas aplican a todas las habitaciones de esta reserva.</p></div>
                    </div>
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                        <label class="flex flex-col gap-1.5"><span class="text-xs font-medium text-on-surface">Check-in <span class="text-error">*</span></span><input asp-for="Reserva.InicioReserva" type="date" id="reservation-start" min="@Model.Hoy.ToString("yyyy-MM-dd")" class="w-full rounded-lg border border-surface-container-high bg-surface-container-lowest px-3 py-2 text-sm text-on-surface focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" /><span asp-validation-for="Reserva.InicioReserva" class="text-xs text-error"></span></label>
                        <label class="flex flex-col gap-1.5"><span class="text-xs font-medium text-on-surface">Número de noches <span class="text-error">*</span></span><input asp-for="Reserva.TotalNoches" type="number" min="1" max="365" id="reservation-nights" class="w-full rounded-lg border border-surface-container-high bg-surface-container-lowest px-3 py-2 text-sm tabular-nums text-on-surface focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" /><span asp-validation-for="Reserva.TotalNoches" class="text-xs text-error"></span></label>
                        <div class="flex flex-col justify-end gap-1.5"><span class="text-xs font-medium text-on-surface">Check-out calculado</span><div class="flex min-h-[38px] items-center gap-2 rounded-lg bg-surface-container px-3 py-2 text-sm font-semibold tabular-nums text-on-surface"><span class="material-symbols-outlined text-base text-on-tertiary-container">event_available</span><span id="reservation-checkout">—</span></div></div>
                    </div>
                </section>

                <section class="flex flex-col gap-3 rounded-xl border border-surface-container-high bg-surface-container-low/50 p-4">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="flex items-center gap-2.5"><span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary text-xs font-bold text-on-primary">3</span><div><h3 class="text-xs font-bold uppercase tracking-wider text-on-surface">Habitaciones asignadas</h3><p class="text-xs text-outline">Elija una o más habitaciones libres para las fechas seleccionadas.</p></div></div>
                        <span class="rounded-md border border-surface-container-high bg-surface-container px-2 py-1 text-[11px] font-mono text-on-surface-variant">1 reserva → varias habitaciones</span>
                    </div>
                    <partial name="_SelectorHabitaciones" model='new SelectorHabitacionesVista("Reserva.HabitacionIds", "#reservation-start", "#reservation-nights", Model.Reserva.HabitacionIds)' />
                    <span asp-validation-for="Reserva.HabitacionIds" class="text-xs text-error"></span>
                </section>
            </div>
            <footer class="flex shrink-0 flex-col gap-3 border-t border-surface-container-high bg-surface-container-lowest px-4 py-3 md:flex-row md:items-center md:justify-between md:px-6">
                <div class="flex items-center justify-between gap-4 md:justify-start">
                    <span class="flex items-center gap-2 text-xs text-on-surface-variant"><span class="material-symbols-outlined text-lg">hotel</span><span><strong id="selected-room-count" class="text-on-surface">0</strong> habitaciones</span></span>
                    <span class="hidden h-6 w-px bg-surface-container-high md:block"></span>
                    <span class="text-xs font-semibold text-on-surface-variant">Total estimado</span>
                    <strong id="reservation-estimate" class="text-lg font-bold tabular-nums text-primary">S/ 0.00</strong>
                </div>
                <div class="flex items-center justify-end gap-2">
                    <button type="button" onclick="cerrarModalReserva()" class="rounded-lg border border-surface-container-high bg-surface-container-lowest px-4 py-2 text-sm font-semibold text-on-surface transition-colors hover:bg-surface-container">Cancelar</button>
                    <button type="submit" class="flex items-center gap-2 rounded-lg bg-primary px-5 py-2 text-sm font-semibold text-on-primary transition-colors hover:bg-primary-container"><span class="material-symbols-outlined text-base">save</span>Crear reserva</button>
                </div>
            </footer>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const modal = document.getElementById('reservationModal');
            const start = document.getElementById('reservation-start');
            const nights = document.getElementById('reservation-nights');
            const userSelect = document.getElementById('reservation-user');
            window.abrirModalReserva = () => { modal.classList.remove('hidden'); modal.classList.add('flex'); document.body.classList.add('overflow-hidden'); };
            window.cerrarModalReserva = () => { modal.classList.add('hidden'); modal.classList.remove('flex'); document.body.classList.remove('overflow-hidden'); };
            function updateSelectedUser() {
                const option = userSelect.options[userSelect.selectedIndex];
                const name = option?.dataset.name || '';
                const role = option?.dataset.role || '';
                document.getElementById('selected-user-name').textContent = name || 'Sin usuario seleccionado';
                document.getElementById('selected-user-role').textContent = role || 'Usuario titular';
                document.getElementById('selected-user-initials').textContent = name
                    ? name.trim().split(/\s+/).slice(0, 2).map(part => part[0]).join('').toUpperCase()
                    : '—';
            }
            function updateCheckout() {
                if (!start.value || !nights.value || Number(nights.value) < 1) {
                    document.getElementById('reservation-checkout').textContent = '—';
                    return;
                }
                const [year, month, day] = start.value.split('-').map(Number);
                const checkout = new Date(year, month - 1, day);
                checkout.setDate(checkout.getDate() + Number(nights.value));
                document.getElementById('reservation-checkout').textContent = new Intl.DateTimeFormat('es-CO', { day: '2-digit', month: 'short', year: 'numeric' }).format(checkout);
            }
            userSelect.addEventListener('change', updateSelectedUser);
            nights.addEventListener('change', updateCheckout);
            start.addEventListener('change', updateCheckout);
            document.addEventListener('keydown', event => { if (event.key === 'Escape') cerrarModalReserva(); });
            updateSelectedUser();
            updateCheckout();
            @if (Model.AbrirModalReserva) { <text>abrirModalReserva();</text> }
        })();
    </script>
}
