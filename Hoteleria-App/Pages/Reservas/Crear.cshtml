@page
@model Hoteleria_App.Pages.Reservas.CrearModel
@using Hoteleria_App.Models
@{
    ViewData["Title"] = "Nueva Reserva";
}

<div class="flex flex-col gap-6 w-full max-w-4xl">

    <!-- ==================== SUB-HEADER ==================== -->
    <section class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-4 md:p-5 shadow-sm flex flex-col gap-4">
        <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-5">
            <div class="flex flex-col gap-1.5">
                <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-bold bg-secondary-fixed/50 px-2.5 py-0.5 rounded-full">• MÓDULO RESERVAS · CREAR</span>
                <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Nueva Reserva</h1>
                <p class="font-body-md text-body-md text-on-surface-variant">Registre una reserva para un huésped, asigne habitaciones y defina el estado inicial de la estancia.</p>
            </div>
            <div class="flex items-center gap-2">
                <a class="flex items-center gap-2 px-4 py-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-body-sm text-body-sm transition-all shadow-sm" asp-page="Index">
                    <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                    <span>Volver al listado</span>
                </a>
            </div>
        </div>
    </section>

    <!-- ==================== FORMULARIO ==================== -->
    <form method="post" id="reservation-form" class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-6 shadow-sm flex flex-col gap-6">
        <div asp-validation-summary="ModelOnly" class="rounded-xl bg-error-container text-on-error-container p-3"></div>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- Datos del Huésped -->
            <div class="lg:col-span-2 flex flex-col gap-4">
                <div class="flex items-center justify-between p-3 rounded-xl bg-surface-container-low border border-surface-container">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-xl bg-secondary-fixed flex items-center justify-center text-secondary">
                            <span class="material-symbols-outlined text-[18px]">person</span>
                        </div>
                        <div>
                            <span class="font-label-sm text-label-sm font-bold uppercase tracking-wider text-on-surface">Huésped / Usuario</span>
                            <span class="font-label-sm text-[10px] text-outline">Seleccione la persona asociada a la reserva</span>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col gap-3">
                    <label class="font-label-sm text-label-sm text-on-surface-variant">Huésped</label>
                    <select asp-for="Reserva.UsuarioId"
                            class="w-full px-3 py-2 bg-surface-container-low rounded-xl text-on-surface font-body-sm text-body-sm focus:outline-none">
                        <option value="0">Seleccione un huésped</option>
                        @foreach (var u in Model.Usuarios)
                        {
                            <option value="@u.UsuarioId">@u.NombreCompleto · @u.CargoNombre</option>
                        }
                    </select>
                    <span asp-validation-for="Reserva.UsuarioId" class="text-label-sm text-error"></span>
                </div>

                <div class="flex flex-col gap-3">
                    <label class="font-label-sm text-label-sm text-on-surface-variant">Fecha de entrada (Check-in)</label>
                    <input asp-for="Reserva.InicioReserva" type="date" id="reservation-start" min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="w-full px-3 py-2 bg-surface-container-low rounded-xl text-on-surface font-body-sm text-body-sm focus:outline-none" />
                    <span asp-validation-for="Reserva.InicioReserva" class="text-label-sm text-error"></span>
                </div>

                <div class="flex flex-col gap-3">
                    <label class="font-label-sm text-label-sm text-on-surface-variant">Número de noches</label>
                    <input asp-for="Reserva.TotalNoches" type="number" min="1" max="365" id="reservation-nights"
                           class="w-full px-3 py-2 bg-surface-container-low rounded-xl text-on-surface font-body-sm text-body-sm focus:outline-none" />
                    <span asp-validation-for="Reserva.TotalNoches" class="text-label-sm text-error"></span>
                </div>

                <div class="flex flex-col gap-3">
                    <label class="font-label-sm text-label-sm text-on-surface-variant">Estado inicial</label>
                    <select asp-for="Reserva.EstadoReserva" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Estados))"
                            class="w-full px-3 py-2 bg-surface-container-low rounded-xl text-on-surface font-body-sm text-body-sm focus:outline-none">
                    </select>
                    <span asp-validation-for="Reserva.EstadoReserva" class="text-label-sm text-error"></span>
                </div>
            </div>

            <!-- Habitaciones -->
            <div class="lg:col-span-1 flex flex-col gap-4">
                <div class="flex items-center justify-between p-3 rounded-xl bg-surface-container-low border border-surface-container">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-xl bg-primary-container flex items-center justify-center text-on-primary">
                            <span class="material-symbols-outlined text-[18px]">meeting_room</span>
                        </div>
                        <div>
                            <span class="font-label-sm text-label-sm font-bold uppercase tracking-wider text-on-surface">Habitaciones</span>
                            <span class="font-label-sm text-[10px] text-outline">Seleccione las habitaciones para la reserva</span>
                        </div>
                    </div>
                </div>

                <div id="available-rooms" class="flex flex-col gap-2 max-h-[400px] overflow-y-auto p-3 rounded-xl bg-surface-container-low border border-surface-container">
                    @if (!Model.Habitaciones.Any())
                    {
                        <div class="text-center text-[11px] text-outline py-8">No hay habitaciones disponibles para esas fechas.</div>
                    }
                    @foreach (var room in Model.Habitaciones)
                    {
                        <label class="room-option flex items-center justify-between gap-3 p-3 rounded-lg bg-surface-container-lowest border border-surface-container cursor-pointer hover:border-secondary">
                            <span class="flex items-center gap-3">
                                <input type="checkbox" name="Reserva.HabitacionIds" value="@room.HabitacionId" data-rate="@(room.PrecioCama * room.NroCamas)" class="room-checkbox rounded border-outline text-secondary focus:ring-secondary" />
                                <span><strong class="block text-on-surface">@room.Codigo · @room.TipoVip</strong><small class="text-outline">@room.NroCamas cama(s)</small></span>
                            </span>
                            <span class="text-right"><strong class="block">$@((room.PrecioCama * room.NroCamas).ToString("N0"))</strong><small class="text-outline">por noche</small></span>
                        </label>
                    }
                </div>
                <span asp-validation-for="Reserva.HabitacionIds" class="text-label-sm text-error"></span>
                <div class="rounded-xl bg-secondary-fixed/40 p-3 flex items-center justify-between">
                    <span class="font-body-sm text-body-sm text-on-surface-variant"><span id="selected-room-count">0</span> habitación(es) · estimado por estancia</span>
                    <strong id="reservation-estimate" class="font-headline-sm text-headline-sm text-on-surface">$0</strong>
                </div>
            </div>

        </div>

        <div class="border-t border-surface-container-high pt-4 flex items-center justify-between">
            <a class="flex items-center gap-2 px-4 py-2 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-body-sm text-body-sm transition-colors" asp-page="Index">
                <span class="material-symbols-outlined text-[16px]">cancel</span>
                <span>Cancelar</span>
            </a>
            <button type="submit" class="px-6 py-2.5 rounded-lg bg-primary hover:bg-on-surface-variant text-on-primary font-body-sm text-body-sm font-semibold transition-all shadow-md">
                <span class="material-symbols-outlined text-[18px]">save</span>
                <span>Guardar Reserva</span>
            </button>
        </div>
    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const start = document.getElementById('reservation-start');
            const nights = document.getElementById('reservation-nights');
            const list = document.getElementById('available-rooms');
            const currency = new Intl.NumberFormat('es-CO', { maximumFractionDigits: 0 });
            const escapeHtml = value => String(value).replace(/[&<>"']/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character]));
            function updateEstimate() {
                const selected = [...list.querySelectorAll('.room-checkbox:checked')];
                const total = selected.reduce((sum, item) => sum + Number(item.dataset.rate || 0), 0) * Math.max(1, Number(nights.value || 1));
                document.getElementById('selected-room-count').textContent = selected.length;
                document.getElementById('reservation-estimate').textContent = '$' + currency.format(total);
            }
            async function loadRooms() {
                if (!start.value || !nights.value || Number(nights.value) < 1) return;
                list.innerHTML = '<p class="text-center text-outline py-5">Buscando disponibilidad…</p>';
                const url = new URL(window.location.href);
                url.search = new URLSearchParams({ handler: 'Disponibles', inicio: start.value, noches: nights.value });
                try {
                    const response = await fetch(url);
                    if (!response.ok) throw new Error('No se pudo consultar la disponibilidad.');
                    const rooms = await response.json();
                    list.innerHTML = rooms.length ? rooms.map(room => `<label class="room-option flex items-center justify-between gap-3 p-3 rounded-lg bg-surface-container-lowest border border-surface-container cursor-pointer hover:border-secondary"><span class="flex items-center gap-3"><input type="checkbox" name="Reserva.HabitacionIds" value="${Number(room.habitacionId)}" data-rate="${Number(room.precioCama) * Number(room.nroCamas)}" class="room-checkbox rounded border-outline text-secondary focus:ring-secondary" /><span><strong class="block text-on-surface">${escapeHtml(room.codigo)} · ${escapeHtml(room.tipoVip)}</strong><small class="text-outline">${Number(room.nroCamas)} cama(s)</small></span></span><span class="text-right"><strong class="block">$${currency.format(Number(room.precioCama) * Number(room.nroCamas))}</strong><small class="text-outline">por noche</small></span></label>`).join('') : '<p class="text-center text-outline py-5">No hay habitaciones libres para esas fechas.</p>';
                    updateEstimate();
                } catch { list.innerHTML = '<p class="text-center text-error py-5">Error al consultar habitaciones. Recargue la página e inténtelo de nuevo.</p>'; }
            }
            list.addEventListener('change', updateEstimate);
            nights.addEventListener('change', () => { updateEstimate(); loadRooms(); });
            start.addEventListener('change', loadRooms);
            updateEstimate();
        })();
    </script>
}
