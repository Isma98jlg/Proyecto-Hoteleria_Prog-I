@if (TempData["MensajeExito"] is string exito) { <div class="rounded-xl bg-green-100 text-green-900 p-3">@exito</div> }
@if (TempData["MensajeError"] is string fallo) { <div class="rounded-xl bg-error-container text-on-error-container p-3">@fallo</div> }
@if (TempData["EnlaceGenerado"] is string enlace)
{
    <div class="rounded-xl bg-secondary-fixed text-on-secondary-fixed p-4 flex flex-col gap-2">
        <strong>Enlace generado. Cópielo y envíelo a la persona; solo se muestra esta vez.</strong>
        <input readonly value="@enlace" onclick="this.select()" class="w-full px-3 py-2 rounded-lg bg-surface-container-lowest text-on-surface font-mono text-sm" />
    </div>
}
