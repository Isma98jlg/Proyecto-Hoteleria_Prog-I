@page
@model Hoteleria_App.Pages.IndexModel
@{
    ViewData["Title"] = "Panel principal";
    var ocupacion = Model.TotalHabitaciones == 0 ? 0 : (int)Math.Round(Model.HabitacionesOcupadas * 100d / Model.TotalHabitaciones);
    var fecha = Model.Hoy.ToString("dddd d 'de' MMMM 'de' yyyy", System.Globalization.CultureInfo.GetCultureInfo("es-PE"));
    fecha = char.ToUpper(fecha[0]) + fecha[1..];
}
<main class="flex flex-col gap-6 w-full">
    <section class="bg-primary-container text-on-primary rounded-2xl p-6 md:p-8 flex flex-col md:flex-row md:items-end md:justify-between gap-5 shadow-sm">
        <div><span class="text-xs uppercase tracking-[.18em] text-secondary-fixed-dim">GrandStay · Operaciones</span><h1 class="font-headline-lg text-headline-lg mt-2">Panel principal</h1><p class="text-on-primary/70 mt-1">@fecha · resumen de habitaciones, reservas y huéspedes.</p></div>
        <a asp-page="/Reservas/Crear" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-secondary-container text-on-secondary-container font-semibold"><span class="material-symbols-outlined">add</span>Nueva reserva</a>
    </section>

    <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
        <a asp-page="/Habitaciones/Index" class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-5 hover:shadow-md transition-shadow"><span class="text-sm text-outline">Habitaciones</span><strong class="block text-3xl mt-2">@Model.TotalHabitaciones</strong><span class="text-xs text-on-surface-variant">Inventario total</span></a>
        <a asp-page="/Habitaciones/Index" asp-route-Estado="LIBRE" class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-5 hover:shadow-md transition-shadow"><span class="text-sm text-outline">Disponibles</span><strong class="block text-3xl mt-2 text-on-tertiary-container">@Model.HabitacionesLibres</strong><span class="text-xs text-on-surface-variant">Listas para asignar</span></a>
        <a asp-page="/Habitaciones/Index" asp-route-Estado="OCUPADO" class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-5 hover:shadow-md transition-shadow"><span class="text-sm text-outline">Ocupadas</span><strong class="block text-3xl mt-2 text-secondary">@Model.HabitacionesOcupadas</strong><span class="text-xs text-on-surface-variant">@ocupacion% de ocupación</span></a>
        <a asp-page="/Reservas/Index" class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-5 hover:shadow-md transition-shadow"><span class="text-sm text-outline">Reservas confirmadas</span><strong class="block text-3xl mt-2">@Model.ReservasConfirmadas</strong><span class="text-xs text-on-surface-variant">@Model.TotalReservas en total</span></a>
    </section>

    <section class="grid grid-cols-1 gap-4 lg:grid-cols-2" aria-label="Movimientos de hoy">
        <div class="flex flex-col gap-3 rounded-2xl border border-surface-container-high bg-surface-container-lowest p-5">
            <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                    <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-tertiary-fixed text-on-tertiary-fixed"><span class="material-symbols-outlined text-[20px]">login</span></span>
                    <div><h2 class="font-headline-sm text-headline-sm">Llegadas de hoy</h2><p class="text-xs text-outline">Check-in pendiente</p></div>
                </div>
                <span class="rounded-full bg-surface-container px-2.5 py-1 text-xs font-bold tabular-nums">@Model.TotalLlegadas</span>
            </div>
            @if (Model.Llegadas.Count == 0)
            {
                <p class="rounded-xl bg-surface-container-low px-4 py-5 text-center text-sm text-outline">No hay llegadas programadas para hoy.</p>
            }
            else
            {
                <ul class="flex flex-col divide-y divide-surface-container">
                    @foreach (var m in Model.Llegadas)
                    {
                        <li class="flex items-center justify-between gap-3 py-2.5">
                            <div class="min-w-0"><strong class="block truncate text-sm">@m.Huesped</strong><span class="text-xs text-on-surface-variant">Hab. @string.Join(", ", m.Habitaciones) · @m.Noches noche(s) · Reserva #@m.ReservaId</span></div>
                            <a asp-page="/Reservas/Detalles" asp-route-id="@m.ReservaId" class="shrink-0 rounded-lg bg-primary px-3 py-1.5 text-xs font-semibold text-on-primary hover:opacity-90">Hacer check-in</a>
                        </li>
                    }
                </ul>
                @if (Model.TotalLlegadas > Model.Llegadas.Count)
                {
                    <a asp-page="/Reservas/Index" asp-route-Estado="CONFIRMADA" class="text-sm font-semibold text-secondary">Ver las @Model.TotalLlegadas →</a>
                }
            }
        </div>
        <div class="flex flex-col gap-3 rounded-2xl border border-surface-container-high bg-surface-container-lowest p-5">
            <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                    <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-secondary-fixed text-on-secondary-fixed"><span class="material-symbols-outlined text-[20px]">logout</span></span>
                    <div><h2 class="font-headline-sm text-headline-sm">Salidas de hoy</h2><p class="text-xs text-outline">Check-out pendiente</p></div>
                </div>
                <span class="rounded-full bg-surface-container px-2.5 py-1 text-xs font-bold tabular-nums">@Model.TotalSalidas</span>
            </div>
            @if (Model.Salidas.Count == 0)
            {
                <p class="rounded-xl bg-surface-container-low px-4 py-5 text-center text-sm text-outline">No hay salidas programadas para hoy.</p>
            }
            else
            {
                <ul class="flex flex-col divide-y divide-surface-container">
                    @foreach (var m in Model.Salidas)
                    {
                        <li class="flex items-center justify-between gap-3 py-2.5">
                            <div class="min-w-0"><strong class="block truncate text-sm">@m.Huesped</strong><span class="text-xs text-on-surface-variant">Hab. @string.Join(", ", m.Habitaciones) · @m.Noches noche(s) · Reserva #@m.ReservaId</span></div>
                            <a asp-page="/Reservas/Detalles" asp-route-id="@m.ReservaId" class="shrink-0 rounded-lg bg-primary px-3 py-1.5 text-xs font-semibold text-on-primary hover:opacity-90">Hacer check-out</a>
                        </li>
                    }
                </ul>
                @if (Model.TotalSalidas > Model.Salidas.Count)
                {
                    <a asp-page="/Reservas/Index" asp-route-Estado="EN_CURSO" class="text-sm font-semibold text-secondary">Ver las @Model.TotalSalidas →</a>
                }
            }
        </div>
    </section>

    <section class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <div class="xl:col-span-2 bg-surface-container-lowest border border-surface-container-high rounded-2xl p-5">
            <div class="flex items-center justify-between mb-5"><div><h2 class="font-headline-sm text-headline-sm">Disponibilidad por piso</h2><p class="text-sm text-outline mt-1">Ocupación actual del inventario</p></div><a asp-page="/Habitaciones/Index" class="text-secondary text-sm font-semibold">Ver habitaciones →</a></div>
            @if (!Model.HabitacionesPorPiso.Any()) { <p class="text-center text-outline py-8">Todavía no hay habitaciones registradas.</p> }
            <div class="flex flex-col gap-4">
            @foreach (var item in Model.HabitacionesPorPiso)
            {
                var total = item.Value.Count;
                var libres = item.Value.Count(h => h.Estado == "LIBRE");
                var ocupadas = item.Value.Count(h => h.Estado == "OCUPADO");
                var mantenimiento = item.Value.Count(h => h.Estado == "MANTENIMIENTO");
                var pct = total == 0 ? 0 : (int)Math.Round(ocupadas * 100d / total);
                <div><div class="flex justify-between text-sm mb-1"><strong>Piso @item.Key</strong><span class="text-outline">@ocupadas ocupadas · @libres libres · @mantenimiento mantenimiento</span></div><div class="h-2 rounded-full bg-surface-container-high overflow-hidden"><div class="h-full bg-secondary-container rounded-full" style="width:@(pct)%"></div></div></div>
            }
            </div>
        </div>
        <div class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-5 flex flex-col gap-4">
            <div><h2 class="font-headline-sm text-headline-sm">Accesos rápidos</h2><p class="text-sm text-outline mt-1">Operaciones frecuentes</p></div>
            <a asp-page="/Reservas/Crear" class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-low hover:bg-surface-container"><span class="material-symbols-outlined text-secondary">calendar_add_on</span><span><strong class="block">Crear reserva</strong><small class="text-outline">Asignar huésped y habitaciones</small></span></a>
            <a asp-page="/Reservas/Index" class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-low hover:bg-surface-container"><span class="material-symbols-outlined">event_note</span><span><strong class="block">Gestionar reservas</strong><small class="text-outline">Revisar estados y estancias</small></span></a>
            <a asp-page="/Habitaciones/Index" class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-low hover:bg-surface-container"><span class="material-symbols-outlined">meeting_room</span><span><strong class="block">Inventario</strong><small class="text-outline">Habitaciones y pisos</small></span></a>
            <a asp-page="/Usuarios/Index" class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-low hover:bg-surface-container"><span class="material-symbols-outlined">group</span><span><strong class="block">Directorio</strong><small class="text-outline">Huéspedes y personas</small></span></a>
            <div class="mt-auto pt-3 border-t border-surface-container-high grid grid-cols-2 gap-3 text-center"><div><strong class="block text-xl">@Model.ReservasConfirmadas</strong><small class="text-outline">Confirmadas</small></div><div><strong class="block text-xl">@Model.TotalClientes</strong><small class="text-outline">Personas</small></div></div>
        </div>
    </section>
</main>
