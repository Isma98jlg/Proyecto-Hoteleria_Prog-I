@page "{id:long}"
@model Hoteleria_App.Pages.Habitaciones.EditarModel
@{
    ViewData["Title"] = "Editar habitación";
}
<main class="max-w-4xl flex flex-col gap-6">
    <section class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-5"><span class="font-label-sm uppercase tracking-wider text-secondary font-bold">HABITACIONES · EDICIÓN</span><h1 class="font-headline-lg text-headline-lg mt-1">Editar habitación #@Model.Habitacion?.HabitacionId</h1><p class="text-on-surface-variant">Actualiza el piso, capacidad, categoría o estado de la habitación.</p></section>
    @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="rounded-xl bg-error-container text-on-error-container p-3"></div> }
    @if (Model.Habitacion is null) { <div class="rounded-xl bg-error-container text-on-error-container p-4">No se encontró la habitación.</div> }
    else
    {
        <form method="post" class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-6 shadow-sm flex flex-col gap-5">
            <input type="hidden" asp-for="Habitacion.HabitacionId" />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <label class="flex flex-col gap-1">Piso<select asp-for="Habitacion.NroPiso" asp-items="Model.PisosDisponibles" class="px-3 py-2 bg-surface-container-low rounded-lg"><option value="">Seleccione un piso</option></select><small class="text-outline">El número no cambia y empieza por su piso: la @Model.Habitacion.HabitacionId va en el piso @(Model.Habitacion.HabitacionId / 100).</small><span asp-validation-for="Habitacion.NroPiso" class="text-error text-sm"></span></label>
                <label class="flex flex-col gap-1">Número de camas<input asp-for="Habitacion.NroCamas" type="number" min="1" max="20" class="px-3 py-2 bg-surface-container-low rounded-lg" /><span asp-validation-for="Habitacion.NroCamas" class="text-error text-sm"></span></label>
                <label class="flex flex-col gap-1">Categoría<select asp-for="Habitacion.TipoVipNombre" asp-items="Model.TiposVipDisponibles" class="px-3 py-2 bg-surface-container-low rounded-lg"><option value="">Seleccione una categoría</option></select><span asp-validation-for="Habitacion.TipoVipNombre" class="text-error text-sm"></span></label>
                <label class="flex flex-col gap-1">Estado<select asp-for="Habitacion.Estado" asp-items="Model.EstadosDisponibles" class="px-3 py-2 bg-surface-container-low rounded-lg"></select><small class="text-outline">«Ocupado» lo asignan el check-in y el check-out de las reservas.</small><span asp-validation-for="Habitacion.Estado" class="text-error text-sm"></span></label>
            </div>
            <div class="flex justify-between border-t border-surface-container-high pt-4"><a asp-page="Detalles" asp-route-id="@Model.Habitacion.HabitacionId" class="px-4 py-2 rounded-lg bg-surface-container">Cancelar</a><button type="submit" class="px-5 py-2 rounded-lg bg-primary text-on-primary font-semibold">Guardar cambios</button></div>
        </form>
        <form method="post" asp-page-handler="Eliminar" asp-route-id="@Model.Habitacion.HabitacionId" onsubmit="return confirm('¿Eliminar esta habitación?')" class="flex justify-end"><button type="submit" class="px-4 py-2 rounded-lg bg-error-container text-on-error-container">Eliminar habitación</button></form>
    }
</main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
