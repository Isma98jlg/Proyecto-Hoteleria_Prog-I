@page "{id:long}"
@model Hoteleria_App.Pages.Habitaciones.DetallesModel
@{
    ViewData["Title"] = $"Habitación #{Model.Habitacion?.HabitacionId}";
    var room = Model.Habitacion;
    var rate = room is null ? 0m : room.NroCamas * (room.TipoVip?.PrecioCama ?? 0m);
}
<main class="flex flex-col gap-6 w-full">
    <partial name="_Mensajes" />
    @if (room is null) { <div class="rounded-xl bg-error-container text-on-error-container p-5">No se encontró la habitación.</div> }
    else
    {
        <section class="bg-primary-container text-on-primary rounded-2xl p-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4 shadow-sm">
            <div><span class="text-xs uppercase tracking-[.18em] text-primary-fixed-dim">INVENTARIO · PISO @room.NroPiso</span><h1 class="font-headline-lg text-headline-lg mt-2">Habitación @room.HabitacionId</h1><p class="text-on-primary/70 mt-1">@(room.Piso?.RefPiso ?? "Sin referencia") · @room.TipoVipNombre</p></div>
            <div class="flex gap-2"><a asp-page="Index" class="px-4 py-2.5 rounded-lg bg-surface-container-lowest/10 text-on-primary">Volver</a>@if (Model.PuedeEditar) { <a asp-page="Editar" asp-route-id="@room.HabitacionId" class="px-4 py-2.5 rounded-lg bg-secondary-container text-on-secondary-container font-semibold">Editar habitación</a> }</div>
        </section>
        <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
            <div class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-5"><span class="text-sm text-outline">Situación hoy</span><strong class="block text-xl mt-2">@Model.Situacion!.Etiqueta</strong>@if (Model.Situacion.Detalle is not null) { <span class="mt-1 block text-xs @(Model.Situacion.Inconsistente ? "font-semibold text-error" : "text-on-surface-variant")">@Model.Situacion.Detalle</span> }</div>
            <div class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-5"><span class="text-sm text-outline">Capacidad</span><strong class="block text-xl mt-2">@room.NroCamas cama(s)</strong></div>
            <div class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-5"><span class="text-sm text-outline">Tarifa por cama / noche</span><strong class="block text-xl mt-2">@Soles.Formatear(room.TipoVip?.PrecioCama ?? 0m)</strong></div>
            <div class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-5"><span class="text-sm text-outline">Tarifa total / noche</span><strong class="block text-xl mt-2">@Soles.Formatear(rate)</strong></div>
        </section>
        @if (Model.PuedeVerReservas) {
        <section class="bg-surface-container-lowest border border-surface-container-high rounded-2xl overflow-hidden">
            <div class="p-5 border-b border-surface-container-high"><h2 class="font-headline-sm text-headline-sm">Historial de reservas <span class="text-outline">(@(room.ReservaHabitaciones?.Count ?? 0))</span></h2></div>
            <div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="bg-surface-container-low text-outline uppercase text-xs"><tr><th class="p-3">Reserva</th><th class="p-3">Huésped</th><th class="p-3">Estado</th><th class="p-3">Estancia</th><th class="p-3 text-right">Precio / noche</th><th class="p-3"></th></tr></thead><tbody class="divide-y divide-surface-container">
            @if (room.ReservaHabitaciones is null || !room.ReservaHabitaciones.Any()) { <tr><td colspan="6" class="p-8 text-center text-outline">Esta habitación todavía no tiene reservas.</td></tr> }
            @foreach (var line in room.ReservaHabitaciones!.OrderByDescending(x => x.Reserva?.InicioReserva))
            {
                var reservation = line.Reserva;
                if (reservation is not null)
                {
                    <tr><td class="p-3 font-mono">#@reservation.ReservaId</td><td class="p-3">@(reservation.Usuario?.Nombres) @(reservation.Usuario?.Apellidos)</td><td class="p-3">@reservation.EstadoReserva</td><td class="p-3">@reservation.InicioReserva.ToString("dd/MM/yyyy") – @reservation.FinReserva.ToString("dd/MM/yyyy")</td><td class="p-3 text-right">@Soles.Formatear(line.PrecioNochePactado)</td><td class="p-3 text-right"><a asp-page="/Reservas/Detalles" asp-route-id="@reservation.ReservaId" class="text-secondary underline">Ver</a></td></tr>
                }
            }
            </tbody></table></div>
        </section>
        }
    }
</main>
