@page "{id:long}"
@model Hoteleria_App.Pages.Habitaciones.DetallesModel
@{
    ViewData["Title"] = $"Habitación #{Model.Habitacion?.HabitacionId}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>🛏️ Detalles de Habitación</h1>
    <div>
        <a asp-page="Editar" asp-route-id="@Model.Habitacion?.HabitacionId" class="btn btn-warning me-2">✏️ Editar</a>
        <a asp-page="Index" class="btn btn-secondary">← Volver</a>
    </div>
</div>

@if (Model.Habitacion == null)
{
    <div class="alert alert-danger">Habitación no encontrada.</div>
}
else
{
    var habitacion = Model.Habitacion;
    var precioTotal = habitacion.NroCamas * (habitacion.TipoVip?.PrecioCama ?? 0);
    var codigo = $"{habitacion.NroPiso:D4}{habitacion.TipoVip?.Sigla}";
    var badgeClass = habitacion.Estado switch
    {
        "LIBRE" => "bg-success",
        "OCUPADO" => "bg-danger",
        "MANTENIMIENTO" => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    <div class="row">
        <!-- Información principal -->
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">📋 Información General</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted small">ID Habitación</label>
                            <div class="fw-bold fs-5">@habitacion.HabitacionId</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Código</label>
                            <div class="fw-bold fs-5">
                                <span class="badge bg-secondary fs-6">@codigo</span>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Piso</label>
                            <div class="fw-bold">@habitacion.NroPiso @(habitacion.Piso?.RefPiso != null ? $"({habitacion.Piso.RefPiso})" : "")</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small">N° Camas</label>
                            <div class="fw-bold">@habitacion.NroCamas</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Estado</label>
                            <div><span class="badge @badgeClass fs-6">@habitacion.Estado</span></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tipo VIP -->
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">⭐ Tipo VIP</h5>
                </div>
                <div class="card-body">
                    @if (habitacion.TipoVip != null)
                    {
                        var tv = habitacion.TipoVip;
                        <div class="row">
                            <div class="col-md-4">
                                <label class="form-label text-muted small">Nombre</label>
                                <div class="fw-bold">@tv.TipoVipNombre</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-muted small">Sigla</label>
                                <div class="fw-bold"><span class="badge bg-warning text-dark">@tv.Sigla</span></div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-muted small">Precio por cama</label>
                                <div class="fw-bold text-success">@tv.PrecioCama.ToString("C")</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">No hay información de tipo VIP asociada.</div>
                    }
                </div>
            </div>

            <!-- Precios -->
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">💰 Precios</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h6 class="text-muted">Precio por cama</h6>
                                    <h3 class="text-primary">@(habitacion.TipoVip?.PrecioCama.ToString("C") ?? "N/A")</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h6 class="text-muted">N° Camas</h6>
                                    <h3 class="text-primary">@habitacion.NroCamas</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card text-center border-success">
                                <div class="card-body">
                                    <h6 class="text-muted">Total por noche</h6>
                                    <h3 class="text-success fw-bold">@precioTotal.ToString("C")</h3>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Historial de reservas -->
            @if (habitacion.ReservaHabitaciones?.Any() == true)
            {
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">📅 Historial de Reservas</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Reserva ID</th>
                                        <th>Cliente</th>
                                        <th>Estado</th>
                                        <th>Inicio</th>
                                        <th>Fin</th>
                                        <th>Noches</th>
                                        <th>Precio/Noche</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rh in habitacion.ReservaHabitaciones.OrderByDescending(r => r.Reserva?.InicioReserva))
                                    {
                                        var r = rh.Reserva;
                                        if (r != null)
                                        {
                                            var estadoBadge = r.EstadoReserva switch
                                            {
                                                "PENDIENTE" => "bg-warning text-dark",
                                                "CONFIRMADA" => "bg-info",
                                                "FINALIZADA" => "bg-success",
                                                "CANCELADA" => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                            <tr>
                                                <td>@r.ReservaId</td>
                                                <td>@(r.Usuario?.Nombres) @(r.Usuario?.Apellidos)</td>
                                                <td><span class="badge @estadoBadge">@r.EstadoReserva</span></td>
                                                <td>@r.InicioReserva.ToString("dd/MM/yyyy")</td>
                                                <td>@r.FinReserva.ToString("dd/MM/yyyy")</td>
                                                <td>@r.TotalNoches</td>
                                                <td>@rh.PrecioNochePactado.ToString("C")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-body text-center text-muted py-4">
                        📭 Esta habitación no tiene historial de reservas.
                    </div>
                </div>
            }
        </div>

        <!-- Panel lateral -->
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">⚡ Acciones Rápidas</h5>
                </div>
                <div class="card-body d-grid gap-2">
                    @if (habitacion.Estado == "LIBRE")
                    {
                        <button class="btn btn-success" disabled>✅ Disponible para reserva</button>
                    }
                    else if (habitacion.Estado == "OCUPADO")
                    {
                        <button class="btn btn-danger" disabled>🔴 Ocupada actualmente</button>
                    }
                    else
                    {
                        <button class="btn btn-warning text-dark" disabled>🔧 En mantenimiento</button>
                    }
                    <a asp-page="Editar" asp-route-id="@habitacion.HabitacionId" class="btn btn-outline-primary">✏️ Editar datos</a>
                    <a asp-page="/Reservas/Crear" asp-route-habitacionId="@habitacion.HabitacionId" class="btn btn-outline-success">📅 Nueva reserva</a>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">📊 Resumen</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-6 text-muted small">Total reservas</dt>
                        <dd class="col-sm-6 fw-bold">@habitacion.ReservaHabitaciones?.Count ?? 0</dd>
                        
                        <dt class="col-sm-6 text-muted small">Noches totales</dt>
                        <dd class="col-sm-6 fw-bold">@(habitacion.ReservaHabitaciones?.Sum(r => r.Reserva?.TotalNoches ?? 0) ?? 0)</dd>
                        
                        <dt class="col-sm-6 text-muted small">Ingresos generados</dt>
                        <dd class="col-sm-6 fw-bold text-success">@(habitacion.ReservaHabitaciones?.Sum(r => r.PrecioNochePactado * (r.Reserva?.TotalNoches ?? 0)) ?? 0).ToString("C")</dd>
                        
                        <dt class="col-sm-6 text-muted small">Última reserva</dt>
                        <dd class="col-sm-6">
                            @{
                                var ultima = habitacion.ReservaHabitaciones?.OrderByDescending(r => r.Reserva?.InicioReserva).FirstOrDefault();
                                if (ultima?.Reserva != null)
                                {
                                    @ultima.Reserva.InicioReserva.ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">Ninguna</span>
                                }
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
}