@page
@model Hoteleria_App.Pages.Habitaciones.IndexModel
@{
    ViewData["Title"] = "Gestión de Habitaciones y Pisos";
}

<div class="flex flex-col gap-6 w-full">

    <!-- ==================== SUB-HEADER OPERATIVO ==================== -->
    <section class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-4 md:p-5 shadow-sm flex flex-col gap-4">
        <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-5">
            <div class="flex flex-col gap-1.5">
                <div class="flex items-center gap-2">
                    <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-bold bg-secondary-fixed/50 px-2.5 py-0.5 rounded-full">• MÓDULO CANÓNICO 2 · EN VIVO</span>
                    <span class="font-label-sm text-label-sm text-outline flex items-center gap-1">
                        <span class="inline-block w-1.5 h-1.5 rounded-full bg-on-tertiary-container"></span> Sincronizado en tiempo real
                    </span>
                </div>
                <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Gestión de Habitaciones y Pisos</h1>
                <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl">Control de inventario inmobiliario, configuración de capacidad de camas por habitación (<strong>1 Cama = 1 Persona</strong>) y zonificación física por niveles bajo las categorías canónicas <strong>Estándar</strong> y <strong>VIP</strong>.</p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <button class="flex items-center gap-2 px-4 py-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-body-sm text-body-sm font-semibold transition-all shadow-sm" onclick="abrirModalPisos()" type="button">
                    <span class="material-symbols-outlined text-[20px]">layers</span>
                    <span>Gestionar Pisos (@Model.Pisos.Count)</span>
                </button>
                <a class="flex items-center gap-2 px-3.5 py-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface font-body-sm text-body-sm transition-all shadow-sm" asp-page-handler="Export" title="Exportar CSV">
                    <span class="material-symbols-outlined text-[19px]">file_download</span>
                    <span>Exportar</span>
                </a>
                <a class="flex items-center gap-2 px-5 py-2.5 rounded-lg bg-primary hover:bg-on-surface-variant text-on-primary font-body-sm text-body-sm font-semibold transition-all shadow-md group" asp-page="Crear">
                    <span class="material-symbols-outlined text-[20px] text-secondary-container transition-transform group-hover:rotate-45">key</span>
                    <span>+ Nueva Habitación</span>
                </a>
            </div>
        </div>

        <!-- Cinta de KPIs Operativos (colapsable) -->
        <div class="w-full bg-surface-container-lowest border border-surface-container rounded-xl p-3 shadow-sm flex flex-col gap-2 shrink-0 transition-all duration-300" id="kpi-ribbon-container">
            <div class="flex items-center justify-between pb-1.5 border-b border-surface-container">
                <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-primary text-on-primary uppercase tracking-wider">Cinta de KPIs Operativos</span>
                    <span class="text-body-sm text-outline font-medium">Resumen consolidado de inventario y distribución canónica de tarifas</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-[11px] text-outline font-numeric-table">Actualizado: ahora</span>
                    <button class="flex items-center gap-1 px-2 py-1 rounded text-outline hover:text-on-surface hover:bg-surface-container text-[12px] font-semibold transition-colors" onclick="toggleKpiRibbon()" title="Colapsar / Expandir cinta" type="button">
                        <span id="kpi-toggle-text">Mostrar Métricas</span>
                        <span class="material-symbols-outlined text-[18px] transition-transform duration-200" id="kpi-ribbon-toggle-icon">keyboard_arrow_down</span>
                    </button>
                </div>
            </div>
            <div class="hidden grid grid-cols-2 md:grid-cols-4 gap-3 pt-1 transition-all duration-300" id="kpi-ribbon-cards">
                <div class="bg-surface-container-low/80 p-3 rounded-lg border border-surface-container flex items-center justify-between">
                    <div class="flex flex-col">
                        <span class="text-[11px] font-semibold text-outline uppercase tracking-wider">Ocupadas (En Estancia)</span>
                        <div class="flex items-baseline gap-1.5 mt-0.5">
                            <span class="font-numeric-table font-bold text-headline-sm text-secondary">@Model.Ocupadas</span>
                            <span class="text-[10px] text-outline">/ @Model.TotalHabitaciones habs</span>
                        </div>
                    </div>
                    <div class="flex flex-col items-end">
                        <span class="text-[10px] font-bold text-secondary bg-secondary-fixed px-2 py-0.5 rounded">@Model.Pct(Model.Ocupadas)% ocupación</span>
                        <span class="text-[10px] text-outline mt-1">@Model.Libres libres • @Model.EnMantenimiento mant.</span>
                    </div>
                </div>
                <div class="bg-surface-container-low/80 p-3 rounded-lg border border-surface-container flex items-center justify-between">
                    <div class="flex flex-col">
                        <span class="text-[11px] font-semibold text-on-tertiary-container uppercase tracking-wider">Libres / Disponibles</span>
                        <div class="flex items-baseline gap-1.5 mt-0.5">
                            <span class="font-numeric-table font-bold text-headline-sm text-on-tertiary-container">@Model.Libres</span>
                            <span class="text-[10px] text-on-tertiary-container font-semibold">@Model.Pct(Model.Libres)%</span>
                        </div>
                    </div>
                    <div class="flex flex-col items-end">
                        <span class="w-2.5 h-2.5 rounded-full bg-on-tertiary-container animate-pulse"></span>
                        <span class="text-[10px] text-outline mt-1">Listas para Check-in</span>
                    </div>
                </div>
                <div class="bg-surface-container-low/80 p-3 rounded-lg border border-surface-container flex items-center justify-between">
                    <div class="flex flex-col">
                        <span class="text-[11px] font-semibold text-outline uppercase tracking-wider">Cat. Estándar (EST)</span>
                        <div class="flex items-baseline gap-1.5 mt-0.5">
                            <span class="font-numeric-table font-bold text-headline-sm text-on-surface">@Model.CategoriaEstandar</span>
                            <span class="text-[10px] text-outline">habs (@Model.Pct(Model.CategoriaEstandar)%)</span>
                        </div>
                    </div>
                    <div class="flex flex-col items-end">
                        <span class="text-[11px] font-bold text-on-surface font-mono">$@Model.Dinero(Model.PrecioCamaEstandar)</span>
                        <span class="text-[10px] text-outline">por cama / noche</span>
                    </div>
                </div>
                <div class="bg-secondary-fixed/30 p-3 rounded-lg border border-secondary/20 flex items-center justify-between">
                    <div class="flex flex-col">
                        <span class="text-[11px] font-semibold text-secondary uppercase tracking-wider">Cat. VIP (Premium)</span>
                        <div class="flex items-baseline gap-1.5 mt-0.5">
                            <span class="font-numeric-table font-bold text-headline-sm text-secondary">@Model.CategoriaVip</span>
                            <span class="text-[10px] text-secondary font-semibold">habs (@Model.Pct(Model.CategoriaVip)%)</span>
                        </div>
                    </div>
                    <div class="flex flex-col items-end">
                        <span class="text-[11px] font-bold text-secondary font-mono">$@Model.Dinero(Model.PrecioCamaVip)</span>
                        <span class="text-[10px] text-secondary">tarifa máx / cama</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== ESPACIO DE TRABAJO ==================== -->
    <div class="flex flex-col gap-6">

        <!-- Selector de Pisos (Niveles del Edificio) -->
        <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <span class="font-label-sm text-label-sm uppercase tracking-wider text-outline font-semibold">Filtrar por Nivel de Edificio (PISOS)</span>
                <div class="flex items-center gap-1 bg-surface-container-low p-1 rounded-lg">
                    <button class="p-1.5 rounded bg-surface-container-lowest shadow-sm text-on-surface flex items-center" id="btnViewGrid" onclick="switchView('grid')" title="Vista en Cuadrícula" type="button">
                        <span class="material-symbols-outlined text-[18px]">grid_view</span>
                    </button>
                    <button class="p-1.5 rounded text-outline hover:text-on-surface flex items-center" id="btnViewTable" onclick="switchView('table')" title="Vista en Tabla" type="button">
                        <span class="material-symbols-outlined text-[18px]">view_list</span>
                    </button>
                </div>
            </div>
            <div class="flex items-center gap-2 overflow-x-auto pb-1" id="floorPills">
                <a class="floor-pill px-4 py-2 rounded-xl @(Model.Piso is null ? "bg-primary text-on-primary" : "bg-surface-container-lowest text-on-surface-variant hover:text-on-surface") font-body-sm text-body-sm font-semibold whitespace-nowrap transition-all shadow-sm" asp-page="Index">
                    Todos los pisos (@Model.TotalHabitaciones habs)
                </a>
                @foreach (var p in Model.Pisos)
                {
                    var activo = Model.Piso == p.NroPiso;
                    <a class="floor-pill px-4 py-2 rounded-xl @(activo ? "bg-primary text-on-primary" : "bg-surface-container-lowest text-on-surface-variant hover:text-on-surface") font-body-sm text-body-sm whitespace-nowrap transition-all shadow-sm flex items-center gap-2" asp-page="Index" asp-route-piso="@p.NroPiso">
                        <span class="w-2 h-2 rounded-full @(p.EsVipPiso ? "bg-secondary-container" : "bg-outline")"></span>
                        <span>Piso @p.NroPiso @(string.IsNullOrWhiteSpace(p.RefPiso) ? "" : "· " + p.RefPiso)</span>
                        <span class="font-label-sm text-label-sm px-1.5 py-0.5 rounded @(activo ? "bg-on-tertiary-container text-surface-container-lowest" : "bg-surface-container text-outline")">@p.Cantidad habs</span>
                    </a>
                }
            </div>
        </div>

        <!-- Barra de Filtros Operativos -->
        <form method="get" class="bg-surface-container-lowest border border-surface-container-high p-4 rounded-2xl shadow-sm flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
            <div class="flex-1 flex flex-wrap sm:flex-nowrap items-center gap-3">
                <div class="relative flex-1 min-w-[220px]">
                    <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">search</span>
                    <input class="w-full pl-10 pr-4 py-2 bg-surface-container-low rounded-xl text-on-surface font-body-sm text-body-sm placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest shadow-inner" name="Buscar" value="@Model.Buscar" placeholder="Buscar por código (ej: S-202) o referencia..." type="text">
                </div>
                <div class="min-w-[210px]">
                    <select class="w-full px-3 py-2 bg-surface-container-low rounded-xl text-on-surface font-body-sm text-body-sm focus:outline-none font-medium" name="Categoria" onchange="this.form.submit()">
                        <option value="">Todas las Categorías</option>
                        <option value="ESTANDAR" selected="@(Model.Categoria == "ESTANDAR")">Estándar (EST) · $@Model.Dinero(Model.PrecioCamaEstandar)/cama</option>
                        <option value="VIP" selected="@(Model.Categoria == "VIP")">VIP (Premium) · $@Model.Dinero(Model.PrecioCamaVip)/cama máx</option>
                    </select>
                </div>
                <div class="min-w-[150px]">
                    <select class="w-full px-3 py-2 bg-surface-container-low rounded-xl text-on-surface font-body-sm text-body-sm focus:outline-none" name="Estado" onchange="this.form.submit()">
                        <option value="">Todos los Estados</option>
                        <option value="LIBRE" selected="@(Model.Estado == "LIBRE")">Libre / Disponible</option>
                        <option value="OCUPADO" selected="@(Model.Estado == "OCUPADO")">Ocupado</option>
                        <option value="MANTENIMIENTO" selected="@(Model.Estado == "MANTENIMIENTO")">Mantenimiento</option>
                    </select>
                </div>
                <div class="min-w-[150px]">
                    <select class="w-full px-3 py-2 bg-surface-container-low rounded-xl text-on-surface font-body-sm text-body-sm focus:outline-none" name="Camas" onchange="this.form.submit()">
                        <option value="">Capacidad (Camas)</option>
                        @foreach (var c in Model.CamasDisponibles)
                        {
                            <option value="@c" selected="@(Model.Camas == c)">@c @(c == 1 ? "Cama" : "Camas")</option>
                        }
                    </select>
                </div>
            </div>
            <div class="flex items-center gap-3 justify-end shrink-0">
                <span class="font-label-sm text-label-sm text-outline">Mostrando @Model.Habitaciones.Count de @Model.TotalHabitaciones</span>
                <button class="px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-variant text-on-surface-variant font-label-sm text-label-sm transition-colors" type="submit">Aplicar</button>
                <a class="px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-variant text-on-surface-variant font-label-sm text-label-sm transition-colors" asp-page="Index">Limpiar Filtros</a>
            </div>
        </form>

        <!-- VISTA CUADRÍCULA -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" id="roomsGrid">
            @if (!Model.Habitaciones.Any())
            {
                <div class="col-span-full bg-surface-container-lowest border border-surface-container-high rounded-2xl p-10 shadow-sm flex flex-col items-center gap-3 text-center">
                    <span class="material-symbols-outlined text-[40px] text-outline">meeting_room</span>
                    <span class="font-headline-sm text-headline-sm text-on-surface">Sin habitaciones que coincidan</span>
                    <span class="font-body-sm text-body-sm text-on-surface-variant">Ajusta los filtros o limpia la búsqueda para volver a ver el inventario.</span>
                    <a class="mt-2 px-4 py-2 rounded-lg bg-primary text-on-primary font-body-sm text-body-sm font-semibold" asp-page="Index">Limpiar filtros</a>
                </div>
            }
            @foreach (var h in Model.Habitaciones)
            {
                var esVip = Model.EsVip(h);
                var topBar = h.Estado == "MANTENIMIENTO" ? "bg-error glow-border" : (esVip ? "bg-secondary glow-border" : "bg-on-tertiary-container glow-border");
                var codeChip = esVip ? "bg-primary-container text-surface-container-lowest shadow-inner" : "bg-surface-container-high text-on-surface";
                var estado = h.Estado;
                var badgeEstado = estado switch
                {
                    "LIBRE" => "bg-surface-container text-on-tertiary-container",
                    "OCUPADO" => "bg-secondary-fixed text-on-secondary-fixed",
                    _ => "bg-error-container text-on-error-container"
                };
                var dotEstado = estado switch
                {
                    "LIBRE" => "bg-on-tertiary-container",
                    "OCUPADO" => "bg-secondary",
                    _ => "bg-error"
                };
                var precio = Model.PrecioCama(h);
                var precioTotal = Model.PrecioTotal(h);

                <div class="group bg-surface-container-lowest border border-surface-container-high rounded-2xl p-4 shadow-sm hover:shadow-md transition-all flex flex-col justify-between relative overflow-hidden">
                    <div class="absolute top-0 left-0 right-0 h-1 @topBar"></div>
                    <div class="flex flex-col gap-3">
                        <div class="flex items-start justify-between">
                            <div class="flex items-center gap-2.5">
                                <div class="h-9 px-2.5 rounded-lg @codeChip flex items-center justify-center font-numeric-table text-numeric-table font-bold tracking-tight whitespace-nowrap">@Model.Codigo(h)</div>
                                <div class="flex flex-col">
                                    @if (esVip)
                                    {
                                        <span class="font-label-sm text-label-sm text-secondary font-bold uppercase tracking-wider flex items-center gap-1 whitespace-nowrap"><span class="material-symbols-outlined text-[14px]">star</span> @h.TipoVipNombre</span>
                                    }
                                    else
                                    {
                                        <span class="font-label-sm text-label-sm text-outline font-semibold uppercase tracking-wider whitespace-nowrap">Estándar</span>
                                    }
                                    <span class="font-body-sm text-body-sm text-on-surface-variant font-medium">Piso @h.NroPiso @(string.IsNullOrWhiteSpace(h.Piso?.RefPiso) ? "" : "· " + h.Piso.RefPiso)</span>
                                </div>
                            </div>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full @badgeEstado font-label-sm text-label-sm font-semibold"><span class="w-2 h-2 rounded-full @dotEstado"></span>@Model.EstadoEtiqueta(estado)</span>
                        </div>
                        <div class="flex items-center gap-4 pt-2 text-on-surface-variant">
                            <span class="flex items-center gap-1.5 font-label-sm text-label-sm"><span class="material-symbols-outlined text-[16px]">bed</span> @h.NroCamas camas</span>
                            <span class="flex items-center gap-1.5 font-label-sm text-label-sm"><span class="material-symbols-outlined text-[16px]">group</span> @h.NroCamas @(h.NroCamas == 1 ? "persona" : "personas")</span>
                        </div>
                    </div>
                    <div class="pt-3 mt-3 flex items-center justify-between bg-surface-container-lowest border-t border-surface-container">
                        <div class="flex flex-col">
                            <span class="font-label-sm text-label-sm text-outline">@h.NroCamas × $@Model.Dinero(precio)</span>
                            <div class="flex items-baseline gap-1"><span class="font-headline-sm text-headline-sm font-bold text-on-surface">$@Model.Dinero(precioTotal)</span><span class="font-label-sm text-label-sm text-outline">/noche</span></div>
                        </div>
                        <a class="px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-label-sm text-label-sm font-semibold flex items-center gap-1.5 whitespace-nowrap transition-colors" asp-page="Editar" asp-route-id="@h.HabitacionId" title="Ver y editar detalle de la habitación">
                            <span class="material-symbols-outlined text-[16px]">edit</span>
                            <span>Editar habitación</span>
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- VISTA TABLA -->
        <div class="hidden bg-surface-container-lowest border border-surface-container-high rounded-2xl shadow-sm overflow-hidden" id="roomsTableWrapper">
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-surface-container-low font-label-md text-label-md text-outline uppercase tracking-wider">
                        <tr>
                            <th class="py-3 px-4">Código Hab.</th>
                            <th class="py-3 px-4">Piso (Nivel)</th>
                            <th class="py-3 px-4">Tipo Canónico</th>
                            <th class="py-3 px-4">Cantidad de Camas</th>
                            <th class="py-3 px-4">Precio Total (Tarifa)</th>
                            <th class="py-3 px-4">Estado</th>
                            <th class="py-3 px-4 text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-container font-body-sm text-body-sm">
                        @foreach (var h in Model.Habitaciones)
                        {
                            var esVip = Model.EsVip(h);
                            var precioTotal = Model.PrecioTotal(h);
                            var estado = h.Estado;
                            var badgeEstado = estado switch
                            {
                                "LIBRE" => "bg-surface-container text-on-tertiary-container",
                                "OCUPADO" => "bg-secondary-fixed text-on-secondary-fixed",
                                _ => "bg-error-container text-on-error-container"
                            };
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3 px-4 font-headline-sm text-headline-sm text-on-surface">@Model.Codigo(h)</td>
                                <td class="py-3 px-4 text-on-surface-variant">Piso @h.NroPiso</td>
                                <td class="py-3 px-4">
                                    @if (esVip)
                                    {
                                        <span class="font-label-sm text-label-sm text-secondary bg-secondary-fixed/60 px-2 py-0.5 rounded font-bold">@h.TipoVipNombre ($@Model.Dinero(Model.PrecioCama(h))/cama)</span>
                                    }
                                    else
                                    {
                                        <span class="font-label-sm text-label-sm text-outline bg-surface-container px-2 py-0.5 rounded font-semibold">Estándar ($@Model.Dinero(Model.PrecioCama(h))/cama)</span>
                                    }
                                </td>
                                <td class="py-3 px-4 font-semibold text-on-surface">@h.NroCamas Camas (@h.NroCamas pers.)</td>
                                <td class="py-3 px-4 font-numeric-table text-numeric-table font-bold text-on-surface">$@Model.Dinero(precioTotal) / noche</td>
                                <td class="py-3 px-4"><span class="px-2 py-0.5 rounded-full @badgeEstado font-label-sm text-label-sm font-semibold">@Model.EstadoEtiqueta(estado)</span></td>
                                <td class="py-3 px-4 text-right">
                                    <a class="p-1 hover:text-on-surface text-outline" asp-page="Editar" asp-route-id="@h.HabitacionId" title="Editar"><span class="material-symbols-outlined text-[18px]">edit</span></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Sección de Gestión: Entidad PISOS (nro_piso, ref_piso) -->
        <div class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-6 shadow-sm flex flex-col gap-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-surface-container flex items-center justify-center text-on-surface">
                        <span class="material-symbols-outlined text-[22px]">stairs</span>
                    </div>
                    <div class="flex flex-col">
                        <h2 class="font-headline-sm text-headline-sm text-on-surface">Estructura de Pisos Registrados</h2>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">Tabla maestra de zonificación vertical (Entidad de Base de Datos: <code class="font-mono text-outline font-semibold">PISOS</code>)</p>
                    </div>
                </div>
                <button class="px-3.5 py-2 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-body-sm text-body-sm font-semibold flex items-center gap-1.5 transition-colors" onclick="abrirModalPisos()" type="button">
                    <span class="material-symbols-outlined text-[18px]">add_circle</span>
                    <span>Registrar Nuevo Nivel</span>
                </button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-surface-container-low font-label-md text-label-md text-outline uppercase tracking-wider">
                        <tr>
                            <th class="py-3 px-4">Número de Piso (<span class="font-mono">nro_piso</span>)</th>
                            <th class="py-3 px-4">Referencia / Denominación (<span class="font-mono">ref_piso</span>)</th>
                            <th class="py-3 px-4">Habitaciones Activas</th>
                            <th class="py-3 px-4">Ocupación por Nivel</th>
                            <th class="py-3 px-4 text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-container font-body-sm text-body-sm">
                        @foreach (var p in Model.Pisos)
                        {
                            var refPiso = p.RefPiso ?? ("Nivel " + p.NroPiso);
                            var barraClase = p.EsVipPiso ? "bg-secondary-container" : "bg-on-tertiary-container";
                            var ocupacionStr = p.OcupacionPct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
                            <tr class="hover:bg-surface-container-low/50">
                                <td class="py-3.5 px-4 font-bold text-on-surface">Piso @p.NroPiso</td>
                                <td class="py-3.5 px-4 text-on-surface font-medium">@refPiso</td>
                                <td class="py-3.5 px-4 text-on-surface-variant">@p.Cantidad unidades</td>
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-2 min-w-[160px]">
                                        <div class="w-24 bg-surface-container-high h-2 rounded-full overflow-hidden">
                                            <div class="@barraClase h-full" style="width: @(ocupacionStr)%"></div>
                                        </div>
                                        <span class="font-label-sm text-label-sm text-outline">@ocupacionStr%</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <button class="px-2.5 py-1 text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm font-semibold rounded hover:bg-surface-container transition-colors" onclick="abrirEditarPiso('@p.NroPiso', '@refPiso')" type="button">Editar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ==================== MODAL: GESTIONAR PISOS ==================== -->
<div class="fixed inset-0 bg-primary/40 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden" id="floorModalBackdrop" onclick="if(event.target === this) cerrarModalPisos()">
    <div class="bg-surface-container-lowest w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden flex flex-col" onclick="event.stopPropagation()">
        <div class="p-6 bg-surface-container-low flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-primary text-on-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">layers</span>
                </div>
                <div>
                    <h3 class="font-headline-sm text-headline-sm text-on-surface">Configurar Pisos del Hotel</h3>
                    <span class="font-label-sm text-label-sm text-outline">Tabla referencial de niveles físicos</span>
                </div>
            </div>
            <button class="text-outline hover:text-on-surface" onclick="cerrarModalPisos()" type="button">
                <span class="material-symbols-outlined text-[22px]">close</span>
            </button>
        </div>
        <div class="p-6 flex flex-col gap-4">
            <form method="post" asp-page-handler="GuardarPiso" class="p-4 rounded-xl bg-surface-container-low flex flex-col gap-3">
                <span class="font-label-sm text-label-sm font-bold uppercase tracking-wider text-on-surface">Añadir / Actualizar Nivel</span>
                <div class="grid grid-cols-3 gap-2">
                    <div>
                        <input class="w-full px-3 py-2 bg-surface-container-lowest rounded-lg text-on-surface font-body-sm text-body-sm focus:outline-none" name="PisoNro" max="99" min="0" placeholder="N° Piso" type="number" id="floorNumberInput">
                    </div>
                    <div class="col-span-2">
                        <input class="w-full px-3 py-2 bg-surface-container-lowest rounded-lg text-on-surface font-body-sm text-body-sm focus:outline-none" name="PisoRef" placeholder="Referencia (ej: Piso 5 - Terraza &amp; VIP)" type="text" id="floorRefInput">
                    </div>
                </div>
                <button class="self-end px-4 py-1.5 rounded-lg bg-primary hover:bg-on-surface-variant text-on-primary font-body-sm text-body-sm font-semibold transition-all" type="submit">+ Guardar Nivel</button>
            </form>
            <div class="flex flex-col gap-2 max-h-56 overflow-y-auto">
                <span class="font-label-sm text-label-sm text-outline uppercase font-semibold">Pisos Existentes</span>
                @foreach (var p in Model.Pisos)
                {
                    <div class="flex items-center justify-between p-3 rounded-xl bg-surface-container-low">
                        <div class="flex items-center gap-3">
                            <span class="w-7 h-7 rounded-lg bg-surface-container flex items-center justify-center font-bold text-on-surface">@p.NroPiso</span>
                            <span class="font-body-sm text-body-sm font-semibold text-on-surface">@(string.IsNullOrWhiteSpace(p.RefPiso) ? "Nivel " + p.NroPiso : p.RefPiso)</span>
                        </div>
                        <span class="font-label-sm text-label-sm @(p.EsVipPiso ? "text-secondary font-bold" : "text-outline")">@p.Cantidad habs@(p.EsVipPiso ? " VIP" : "")</span>
                    </div>
                }
            </div>
        </div>
        <div class="p-4 bg-surface-container-low flex justify-end">
            <button class="px-4 py-2 rounded-xl bg-primary text-on-primary font-body-sm text-body-sm font-semibold" onclick="cerrarModalPisos()" type="button">Listo</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Interactividad propia de la pantalla (el drawer/Bento ya viven en site.js)

        // Cinta colapsable de KPIs
        function toggleKpiRibbon() {
            const cards = document.getElementById('kpi-ribbon-cards');
            const icon = document.getElementById('kpi-ribbon-toggle-icon');
            const label = document.getElementById('kpi-toggle-text');
            if (!cards) return;
            if (cards.classList.contains('hidden')) {
                cards.classList.remove('hidden');
                if (icon) icon.textContent = 'keyboard_arrow_up';
                if (label) label.textContent = 'Ocultar Métricas';
            } else {
                cards.classList.add('hidden');
                if (icon) icon.textContent = 'keyboard_arrow_down';
                if (label) label.textContent = 'Mostrar Métricas';
            }
        }

        // Vista cuadrícula / tabla
        function switchView(view) {
            const grid = document.getElementById('roomsGrid');
            const table = document.getElementById('roomsTableWrapper');
            const btnGrid = document.getElementById('btnViewGrid');
            const btnTable = document.getElementById('btnViewTable');
            if (!grid || !table) return;
            if (view === 'grid') {
                grid.classList.remove('hidden'); table.classList.add('hidden');
                btnGrid.classList.add('bg-surface-container-lowest', 'text-on-surface', 'shadow-sm');
                btnGrid.classList.remove('text-outline');
                btnTable.classList.remove('bg-surface-container-lowest', 'text-on-surface', 'shadow-sm');
                btnTable.classList.add('text-outline');
            } else {
                grid.classList.add('hidden'); table.classList.remove('hidden');
                btnTable.classList.add('bg-surface-container-lowest', 'text-on-surface', 'shadow-sm');
                btnTable.classList.remove('text-outline');
                btnGrid.classList.remove('bg-surface-container-lowest', 'text-on-surface', 'shadow-sm');
                btnGrid.classList.add('text-outline');
            }
        }

        // Modal Gestionar Pisos
        function abrirModalPisos() {
            const modal = document.getElementById('floorModalBackdrop');
            if (modal) modal.classList.remove('hidden');
        }
        function cerrarModalPisos() {
            const modal = document.getElementById('floorModalBackdrop');
            if (modal) modal.classList.add('hidden');
        }
        function abrirEditarPiso(nro, ref) {
            const nroInput = document.getElementById('floorNumberInput');
            const refInput = document.getElementById('floorRefInput');
            if (nroInput) nroInput.value = nro;
            if (refInput) refInput.value = ref;
            abrirModalPisos();
            if (nroInput) nroInput.focus();
        }

        // Cerrar el modal de pisos con ESC
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') cerrarModalPisos();
        });
    </script>

    <style>
        .glow-border {
            box-shadow: 0 0 12px 2px currentColor;
            opacity: 0.95;
        }
    </style>
}
