@page
@model Hoteleria_App.Pages.Habitaciones.IndexModel
@{
    ViewData["Title"] = "Explorador de Habitaciones";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>🛏️ Explorador de Habitaciones</h1>
    <a asp-page="Crear" class="btn btn-primary">➕ Nueva Habitación</a>
</div>

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">🔍 Filtros</h5>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label for="estado" class="form-label">Estado</label>
                <select class="form-select" id="estado" name="estado" asp-items="@Model.EstadosDisponibles">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="piso" class="form-label">Piso</label>
                <select class="form-select" id="piso" name="piso" asp-items="@Model.PisosDisponibles">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="tipoVip" class="form-label">Tipo VIP</label>
                <select class="form-select" id="tipoVip" name="tipoVip" asp-items="@Model.TiposVipDisponibles">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">🔍 Filtrar</button>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de habitaciones -->
<div class="card">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0">📋 Listado de Habitaciones (@Model.Habitaciones.Count)</h5>
        <span class="badge bg-primary rounded-pill">Total: @Model.Habitaciones.Count</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Habitaciones.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Código</th>
                            <th>Piso</th>
                            <th>Camas</th>
                            <th>Tipo VIP</th>
                            <th>Precio/Cama</th>
                            <th>Precio Total</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var habitacion in Model.Habitaciones)
                        {
                            <tr>
                                <td>@habitacion.HabitacionId</td>
                                <td>
                                    <span class="badge bg-secondary">
                                        @($"{habitacion.NroPiso:D4}{habitacion.TipoVip?.Sigla}")
                                    </span>
                                </td>
                                <td>@habitacion.NroPiso</td>
                                <td>@habitacion.NroCamas</td>
                                <td>
                                    @if (habitacion.TipoVip != null)
                                    {
                                        <span class="badge bg-warning text-dark">@habitacion.TipoVip.TipoVipNombre (@habitacion.TipoVip.Sigla)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@(habitacion.TipoVip?.PrecioCama.ToString("C") ?? "-")</td>
                                <td class="fw-bold">
                                    @((habitacion.NroCamas * (habitacion.TipoVip?.PrecioCama ?? 0)).ToString("C"))
                                </td>
                                <td>
                                    @{
                                        var badgeClass = habitacion.Estado switch
                                        {
                                            "LIBRE" => "bg-success",
                                            "OCUPADO" => "bg-danger",
                                            "MANTENIMIENTO" => "bg-warning text-dark",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass">@habitacion.Estado</span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-page="Detalles" asp-route-id="@habitacion.HabitacionId" class="btn btn-outline-primary" title="Ver detalles">👁️</a>
                                        <a asp-page="Editar" asp-route-id="@habitacion.HabitacionId" class="btn btn-outline-warning" title="Editar">✏️</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="text-muted">🛏️ No se encontraron habitaciones con los filtros seleccionados</div>
                <a asp-page="Index" class="btn btn-link mt-2">Limpiar filtros</a>
            </div>
        }
    </div>
</div>

<!-- Resumen rápido -->
@if (Model.Habitaciones.Any())
{
    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-success">@Model.Habitaciones.Count(h => h.Estado == "LIBRE")</h3>
                    <small class="text-muted">Disponibles</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-danger">@Model.Habitaciones.Count(h => h.Estado == "OCUPADO")</h3>
                    <small class="text-muted">Ocupadas</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-warning">@Model.Habitaciones.Count(h => h.Estado == "MANTENIMIENTO")</h3>
                    <small class="text-muted">Mantenimiento</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-primary">@Model.Habitaciones.Sum(h => h.NroCamas * (h.TipoVip?.PrecioCama ?? 0))</h3>
                    <small class="text-muted">Ingreso potencial/noche</small>
                </div>
            </div>
        </div>
    </div>
}