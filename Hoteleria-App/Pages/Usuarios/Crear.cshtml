@page
@model Hoteleria_App.Pages.Usuarios.CrearModel
@{
    ViewData["Title"] = "Nuevo huésped";
}
<main class="max-w-4xl flex flex-col gap-6">
    <section><span class="font-label-sm uppercase tracking-wider text-secondary font-bold">DIRECTORIO · REGISTRO</span><h1 class="font-headline-lg text-headline-lg mt-1">Nuevo huésped</h1><p class="text-on-surface-variant">Registra los datos de contacto para futuras reservas.</p></section>
    <form method="post" class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-6 shadow-sm flex flex-col gap-5">
        <div asp-validation-summary="ModelOnly" class="rounded-xl bg-error-container text-on-error-container p-3"></div>
        <partial name="_FormPersona" for="Persona" />
        <partial name="_VerificarDocumentoPersonal" />
        <div class="flex justify-between border-t border-surface-container-high pt-4"><a asp-page="Index" class="px-4 py-2 rounded-lg bg-surface-container">Cancelar</a><button class="px-5 py-2 rounded-lg bg-primary text-on-primary font-semibold" type="submit">Guardar huésped</button></div>
    </form>
</main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
