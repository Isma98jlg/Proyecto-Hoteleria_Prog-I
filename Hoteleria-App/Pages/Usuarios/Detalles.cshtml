@page "{id:long}"
@model Hoteleria_App.Pages.Usuarios.DetallesModel
@{
    ViewData["Title"] = "Ficha de persona";
    var persona = Model.Persona!;
}
<main class="flex flex-col gap-6 w-full">
    <section class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-5 shadow-sm flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div><span class="font-label-sm uppercase tracking-wider text-secondary font-bold">DIRECTORIO · FICHA</span><h1 class="font-headline-lg text-headline-lg mt-1">@persona.NombreCompleto</h1><p class="text-on-surface-variant">@persona.TipoDocumento · @persona.NumeroDocumento</p></div>
        <div class="flex gap-2"><a asp-page="Index" class="px-4 py-2 rounded-lg bg-surface-container">Volver</a>@if (Model.PuedeAdministrar && !persona.EsEmpleado) { <a asp-page="Editar" asp-route-id="@persona.UsuarioId" class="px-4 py-2 rounded-lg bg-primary text-on-primary">Editar datos</a> }</div>
    </section>
    <partial name="_Mensajes" />
    @if (!persona.EsEmpleado)
    {
        <form method="post" asp-page-handler="@(persona.TieneCuenta ? "Restablecer" : "Activacion")" asp-route-id="@persona.UsuarioId" class="flex flex-wrap items-center justify-between gap-3 bg-surface-container-lowest border border-surface-container-high rounded-2xl p-4">
            <span class="text-on-surface-variant">@(persona.TieneCuenta ? "Tiene cuenta de acceso." : "Todavía no tiene cuenta de acceso.")</span>
            <button type="submit" class="px-4 py-2 rounded-lg bg-surface-container font-semibold">@(persona.TieneCuenta ? "Generar enlace para restablecer contraseña" : "Generar enlace de activación")</button>
        </form>
    }
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <div class="lg:col-span-1 bg-surface-container-lowest border border-surface-container-high rounded-2xl p-5"><h2 class="font-headline-sm text-headline-sm mb-4">Información de contacto</h2><dl class="flex flex-col gap-4"><div><dt class="text-xs text-outline uppercase">Correo de acceso</dt><dd>@persona.EMail</dd></div><div><dt class="text-xs text-outline uppercase">Correo de contacto</dt><dd>@(persona.CorreoContacto ?? "Sin indicar")</dd></div><div><dt class="text-xs text-outline uppercase">Teléfono</dt><dd>@persona.Telefono</dd></div><div><dt class="text-xs text-outline uppercase">Nacionalidad</dt><dd>@persona.Nacionalidad</dd></div><div><dt class="text-xs text-outline uppercase">Perfil</dt><dd>@(persona.EsEmpleado ? "Personal del hotel" : "Huésped")</dd></div><div><dt class="text-xs text-outline uppercase">ID interno</dt><dd>@persona.UsuarioId</dd></div></dl></div>
        <div class="lg:col-span-2 bg-surface-container-lowest border border-surface-container-high rounded-2xl overflow-hidden"><div class="p-5 border-b border-surface-container-high"><h2 class="font-headline-sm text-headline-sm">Historial de reservas <span class="text-outline">(@persona.Reservas.Count)</span></h2></div><div class="overflow-x-auto"><table class="w-full text-sm text-left"><thead class="bg-surface-container-low text-outline uppercase text-xs"><tr><th class="p-3">Reserva</th><th class="p-3">Estado</th><th class="p-3">Estancia</th><th class="p-3">Habitaciones</th><th class="p-3 text-right">Total</th><th class="p-3"></th></tr></thead><tbody class="divide-y divide-surface-container">
        @if (!persona.Reservas.Any()) { <tr><td colspan="6" class="p-8 text-center text-outline">Todavía no hay reservas.</td></tr> }
        @foreach (var r in persona.Reservas) { <tr><td class="p-3 font-mono">#@r.ReservaId</td><td class="p-3">@r.Estado</td><td class="p-3">@r.Inicio.ToString("dd/MM/yyyy") – @r.Fin.ToString("dd/MM/yyyy")<small class="block text-outline">@r.TotalNoches noche(s)</small></td><td class="p-3">@r.TotalHabitaciones</td><td class="p-3 text-right">$@r.Total.ToString("N0")</td><td class="p-3 text-right"><a asp-page="/Reservas/Detalles" asp-route-id="@r.ReservaId" class="text-secondary underline">Ver</a></td></tr> }
        </tbody></table></div></div>
    </section>
</main>
