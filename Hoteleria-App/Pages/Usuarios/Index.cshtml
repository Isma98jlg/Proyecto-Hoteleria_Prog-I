@page
@model Hoteleria_App.Pages.Usuarios.IndexModel
@{
    ViewData["Title"] = "Gestión de Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>👥 Gestión de Clientes</h1>
    <a asp-page="Crear" class="btn btn-primary">➕ Nuevo Cliente</a>
</div>

<div class="alert alert-info">
    <h5>🚧 En construcción</h5>
    <p class="mb-0">Esta sección estará disponible próximamente. Incluirá:</p>
    <ul class="mb-0">
        <li>Listado de clientes con búsqueda por documento, nombre, email</li>
        <li>Registro de nuevos huéspedes</li>
        <li>Historial de estancias por cliente</li>
        <li>Preferencias y notas</li>
    </ul>
</div>

<div class="card">
    <div class="card-header bg-light">
        <h5 class="mb-0">📊 Resumen</h5>
    </div>
    <div class="card-body">
        <div class="row text-center">
            <div class="col-md-4">
                <h2 class="text-primary">@Model.TotalClientes</h2>
                <small class="text-muted">Total registrados</small>
            </div>
            <div class="col-md-4">
                <h2 class="text-info">@Model.ConReservas</h2>
                <small class="text-muted">Con reservas</small>
            </div>
            <div class="col-md-4">
                <h2 class="text-warning">@Model.SinReservas</h2>
                <small class="text-muted">Sin reservas</small>
            </div>
        </div>
    </div>
</div>