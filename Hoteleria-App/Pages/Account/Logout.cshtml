@page
@model Hoteleria_App.Pages.Account.LogoutModel
@{
    Layout = "_LayoutPublico";
    ViewData["Title"] = "Cerrar sesión";
    ViewData["Subtitulo"] = "Confirme que desea salir del sistema";
}
<div class="flex flex-col gap-5">
    <div class="flex items-start gap-3 rounded-xl bg-surface-container-low p-4">
        <span class="material-symbols-outlined text-[22px] text-secondary" aria-hidden="true">logout</span>
        <p class="text-sm text-on-surface-variant">Se cerrará la sesión de <strong class="text-on-surface">@User.Identity?.Name</strong> en este navegador. Los cambios ya guardados se conservan.</p>
    </div>
    <form method="post" class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-between">
        <a href="/" class="rounded-lg bg-surface-container px-4 py-2.5 text-center font-semibold text-on-surface hover:bg-surface-container-high">Volver</a>
        <button type="submit" data-enviando="Cerrando sesión…" class="rounded-lg bg-primary px-5 py-2.5 font-semibold text-on-primary hover:opacity-90">Cerrar sesión</button>
    </form>
</div>
