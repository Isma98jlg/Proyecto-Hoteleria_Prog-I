@page
@model Hoteleria_App.Pages.Account.LoginModel
@inject Hoteleria_App.Services.DominioCorreo Dominio
@{
    Layout = null;
    var ejemplo = $"usuario@{Dominio.Dominio}";
    ViewData["Title"] = "Iniciar sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GrandStay HMS</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-secondary": "#ffffff",
                        "inverse-primary": "#bec6e0",
                        "error-container": "#ffdad6",
                        "on-primary-container": "#7c839b",
                        "primary": "#000000",
                        "on-primary-fixed": "#131b2e",
                        "on-secondary-container": "#663500",
                        "outline-variant": "#c6c6cd",
                        "secondary": "#904d00",
                        "background": "#faf9f7",
                        "surface-variant": "#e3e2e0",
                        "on-error": "#ffffff",
                        "tertiary-fixed-dim": "#68dba9",
                        "primary-fixed-dim": "#bec6e0",
                        "on-tertiary-container": "#069669",
                        "surface-container-high": "#e9e8e6",
                        "on-surface": "#1a1c1b",
                        "outline": "#76777d",
                        "tertiary-container": "#002114",
                        "secondary-fixed-dim": "#ffb77d",
                        "on-surface-variant": "#45464d",
                        "on-tertiary-fixed-variant": "#005137",
                        "on-secondary-fixed-variant": "#6e3900",
                        "surface": "#faf9f7",
                        "surface-tint": "#565e74",
                        "surface-bright": "#faf9f7",
                        "tertiary-fixed": "#85f8c4",
                        "on-tertiary": "#ffffff",
                        "surface-container-low": "#f4f3f1",
                        "secondary-fixed": "#ffdcc3",
                        "primary-fixed": "#dae2fd",
                        "surface-container-lowest": "#ffffff",
                        "tertiary": "#000000",
                        "primary-container": "#131b2e",
                        "surface-container": "#efeeec",
                        "on-background": "#1a1c1b",
                        "secondary-container": "#fe932c",
                        "on-secondary-fixed": "#2f1500",
                        "inverse-on-surface": "#f1f1ef",
                        "error": "#ba1a1a",
                        "on-primary": "#ffffff",
                        "on-tertiary-fixed": "#002114",
                        "on-primary-fixed-variant": "#3f465c",
                        "inverse-surface": "#2f3130",
                        "surface-dim": "#dadad8",
                        "surface-container-highest": "#e3e2e0",
                        "on-error-container": "#93000a"
                    },
                    borderRadius: {
                        DEFAULT: "0.25rem",
                        lg: "0.5rem",
                        xl: "0.75rem",
                        full: "9999px"
                    },
                    spacing: {
                        "gutter": "1.25rem",
                        "space-md": "0.75rem",
                        "space-lg": "1.25rem",
                        "space-xl": "2rem",
                        "space-xs": "0.25rem",
                        "gutter-desktop": "1.5rem",
                        "margin-desktop": "2rem",
                        "space-sm": "0.5rem",
                        "margin": "1rem"
                    },
                    fontFamily: {
                        "headline-md": ["Plus Jakarta Sans"],
                        "headline-xl": ["Plus Jakarta Sans"],
                        "headline-xl-mobile": ["Plus Jakarta Sans"],
                        "label-md": ["Plus Jakarta Sans"],
                        "body-md": ["Plus Jakarta Sans"],
                        "headline-sm": ["Plus Jakarta Sans"],
                        "label-sm": ["Plus Jakarta Sans"],
                        "numeric-table": ["Plus Jakarta Sans"],
                        "headline-lg": ["Plus Jakarta Sans"],
                        "body-sm": ["Plus Jakarta Sans"],
                        "body-lg": ["Plus Jakarta Sans"],
                        "display-lg": ["Plus Jakarta Sans"],
                        "headline-lg-mobile": ["Plus Jakarta Sans"]
                    },
                    fontSize: {
                        "headline-md": ["1.25rem", { "lineHeight": "1.625rem", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "headline-xl": ["2.25rem", { "lineHeight": "2.75rem", "letterSpacing": "-0.025em", "fontWeight": "600" }],
                        "headline-xl-mobile": ["1.75rem", { "lineHeight": "2.25rem", "letterSpacing": "-0.02em", "fontWeight": "600" }],
                        "label-md": ["0.75rem", { "lineHeight": "1rem", "letterSpacing": "0.04em", "fontWeight": "600" }],
                        "body-md": ["0.875rem", { "lineHeight": "1.375rem", "letterSpacing": "0em", "fontWeight": "400" }],
                        "headline-sm": ["1.125rem", { "lineHeight": "1.5rem", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "label-sm": ["0.6875rem", { "lineHeight": "0.875rem", "letterSpacing": "0.06em", "fontWeight": "700" }],
                        "numeric-table": ["0.875rem", { "lineHeight": "1.25rem", "letterSpacing": "-0.01em", "fontWeight": "500" }],
                        "headline-lg": ["1.75rem", { "lineHeight": "2.25rem", "letterSpacing": "-0.02em", "fontWeight": "600" }],
                        "body-sm": ["0.8125rem", { "lineHeight": "1.25rem", "letterSpacing": "0.005em", "fontWeight": "400" }],
                        "body-lg": ["1rem", { "lineHeight": "1.5rem", "letterSpacing": "0em", "fontWeight": "400" }],
                        "display-lg": ["3rem", { "lineHeight": "3.5rem", "letterSpacing": "-0.03em", "fontWeight": "700" }],
                        "headline-lg-mobile": ["1.375rem", { "lineHeight": "1.75rem", "letterSpacing": "-0.015em", "fontWeight": "600" }]
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-surface font-body-md text-on-surface antialiased min-h-screen">
    <main class="min-h-screen flex items-center justify-center p-6">
        <div class="w-full max-w-[420px]">
            <div class="bg-surface-container-lowest rounded-2xl border border-surface-container-high shadow-xl overflow-hidden">
                <div class="px-6 pt-7 pb-6 flex flex-col items-center text-center border-b border-surface-container">
                    <img alt="GrandStay HMS" class="h-12 w-auto object-contain mb-4" src="~/images/grandstay-logo.png" />
                    <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Iniciar sesión</h1>
                    <p class="font-body-sm text-body-sm text-on-surface-variant mt-1.5">Acceso unificado al Hospitality Management Suite (HMS)</p>
                </div>
                <div class="p-6">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="mb-4 bg-error-container text-on-error-container text-body-sm rounded-lg px-3 py-2.5 flex items-center gap-2">
                            <span class="material-symbols-outlined text-[18px]">error</span>
                            <span>@(ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage ?? "Revise los datos ingresados.")</span>
                        </div>
                    }
                    <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="flex flex-col gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Input.Email" class="font-label-sm text-label-sm text-on-surface-variant">Correo</label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">mail</span>
                                <input asp-for="Input.Email" type="email" autocomplete="username" placeholder="@ejemplo"
                                       class="w-full pl-11 pr-4 py-2.5 rounded-lg bg-surface-container-lowest border border-surface-container-high text-on-surface text-body-sm focus:outline-none focus:border-primary placeholder:text-outline" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-label-sm text-error"></span>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <div class="flex items-center justify-between">
                                <label asp-for="Input.Password" class="font-label-sm text-label-sm text-on-surface-variant">Contraseña</label>
                            </div>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">lock</span>
                                <input asp-for="Input.Password" autocomplete="current-password" placeholder="••••••••"
                                       class="w-full pl-11 pr-11 py-2.5 rounded-lg bg-surface-container-lowest border border-surface-container-high text-on-surface text-body-sm focus:outline-none focus:border-primary placeholder:text-outline" />
                                <button type="button" onclick="togglePassword()" title="Mostrar/ocultar contraseña"
                                        class="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-lg flex items-center justify-center text-outline hover:text-on-surface transition-colors">
                                    <span class="material-symbols-outlined text-[20px]" id="toggle-password-icon">visibility</span>
                                </button>
                            </div>
                            <span asp-validation-for="Input.Password" class="text-label-sm text-error"></span>
                        </div>
                        <label class="flex items-center gap-2 cursor-pointer select-none">
                            <input asp-for="Input.RememberMe" class="rounded border-outline-variant text-primary focus:ring-primary" />
                            <span class="font-body-sm text-body-sm text-on-surface-variant">Recordarme</span>
                        </label>
                        <button type="submit"
                                class="mt-1 w-full py-2.5 rounded-lg bg-primary text-on-primary font-body-sm text-body-sm font-semibold hover:opacity-90 transition-opacity">
                            Iniciar sesión
                        </button>
                        <p class="text-center font-label-sm text-label-sm text-outline">¿Es huésped y no tiene cuenta? <a asp-page="/Account/Registro" class="text-secondary font-semibold hover:underline">Regístrese aquí</a></p>
                        <p class="text-center font-label-sm text-label-sm text-outline">¿Olvidó su contraseña? Solicite un enlace en recepción.</p>
                    </form>
                </div>
            </div>
            <p class="text-center mt-4 font-label-sm text-label-sm text-outline">&copy; 2026 GrandStay Hotels · Consola Unificada</p>
        </div>
    </main>

    <script>
        function togglePassword() {
            const input = document.querySelector('input[type="password"]');
            const icon = document.getElementById('toggle-password-icon');
            const isPassword = input && input.type === 'password';
            if (input) input.type = isPassword ? 'text' : 'password';
            if (icon) icon.textContent = isPassword ? 'visibility_off' : 'visibility';
        }
    </script>
</body>
</html>
