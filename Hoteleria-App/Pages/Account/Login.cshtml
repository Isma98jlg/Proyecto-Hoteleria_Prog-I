@page
@model Hoteleria_App.Pages.Account.LoginModel
@inject Hoteleria_App.Services.DominioCorreo Dominio
@{
    Layout = null;
    var ejemplo = $"usuario@{Dominio.Dominio}";
    ViewData["Title"] = "Iniciar sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GrandStay HMS</title>
    <partial name="_Head" />
</head>
<body class="bg-surface font-body-md text-on-surface antialiased min-h-screen">
    <main class="min-h-screen flex items-center justify-center p-6">
        <div class="w-full max-w-[420px]">
            <div class="bg-surface-container-lowest rounded-2xl border border-surface-container-high shadow-xl overflow-hidden">
                <div class="px-6 pt-7 pb-6 flex flex-col items-center text-center border-b border-surface-container">
                    <img alt="GrandStay HMS" class="h-12 w-auto object-contain mb-4" src="~/images/grandstay-logo.png" />
                    <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Iniciar sesión</h1>
                    <p class="font-body-sm text-body-sm text-on-surface-variant mt-1.5">Acceso para huéspedes y personal del hotel</p>
                </div>
                <div class="p-6">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="mb-4 bg-error-container text-on-error-container text-body-sm rounded-lg px-3 py-2.5 flex items-center gap-2">
                            <span class="material-symbols-outlined text-[18px]">error</span>
                            <span>@(ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage ?? "Revise los datos ingresados.")</span>
                        </div>
                    }
                    <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="flex flex-col gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Input.Email" class="font-label-sm text-label-sm text-on-surface-variant">Correo</label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">mail</span>
                                <input asp-for="Input.Email" type="email" autocomplete="username" placeholder="@ejemplo"
                                       class="w-full pl-11 pr-4 py-2.5 rounded-lg bg-surface-container-lowest border border-surface-container-high text-on-surface text-body-sm focus:outline-none focus:border-primary placeholder:text-outline" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-label-sm text-error"></span>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <div class="flex items-center justify-between">
                                <label asp-for="Input.Password" class="font-label-sm text-label-sm text-on-surface-variant">Contraseña</label>
                            </div>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">lock</span>
                                <input asp-for="Input.Password" autocomplete="current-password" placeholder="••••••••"
                                       class="w-full pl-11 pr-11 py-2.5 rounded-lg bg-surface-container-lowest border border-surface-container-high text-on-surface text-body-sm focus:outline-none focus:border-primary placeholder:text-outline" />
                                <button type="button" onclick="togglePassword()" title="Mostrar/ocultar contraseña"
                                        class="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-lg flex items-center justify-center text-outline hover:text-on-surface transition-colors">
                                    <span class="material-symbols-outlined text-[20px]" id="toggle-password-icon">visibility</span>
                                </button>
                            </div>
                            <span asp-validation-for="Input.Password" class="text-label-sm text-error"></span>
                        </div>
                        <label class="flex items-center gap-2 cursor-pointer select-none">
                            <input asp-for="Input.RememberMe" class="rounded border-outline-variant text-primary focus:ring-primary" />
                            <span class="font-body-sm text-body-sm text-on-surface-variant">Recordarme</span>
                        </label>
                        <button type="submit"
                                class="mt-1 w-full py-2.5 rounded-lg bg-primary text-on-primary font-body-sm text-body-sm font-semibold hover:opacity-90 transition-opacity">
                            Iniciar sesión
                        </button>
                        <p class="text-center font-label-sm text-label-sm text-outline">¿Es huésped y no tiene cuenta? <a asp-page="/Account/Registro" class="text-secondary font-semibold hover:underline">Regístrese aquí</a></p>
                        <p class="text-center font-label-sm text-label-sm text-outline">¿Olvidó su contraseña? Solicite un enlace en recepción.</p>
                    </form>
                </div>
            </div>
            <p class="text-center mt-4 font-label-sm text-label-sm text-outline">&copy; 2026 GrandStay Hotels · Sistema de gestión hotelera</p>
        </div>
    </main>

    <script>
        function togglePassword() {
            const input = document.querySelector('input[type="password"]');
            const icon = document.getElementById('toggle-password-icon');
            const isPassword = input && input.type === 'password';
            if (input) input.type = isPassword ? 'text' : 'password';
            if (icon) icon.textContent = isPassword ? 'visibility_off' : 'visibility';
        }
    </script>
    <partial name="_AvisoGlobal" />
</body>
</html>
