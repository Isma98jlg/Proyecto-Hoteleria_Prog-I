@page
@model Hoteleria_App.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Acceso denegado";
}
<main class="max-w-2xl mx-auto w-full py-10">
    <section class="bg-surface-container-lowest border border-surface-container-high rounded-2xl p-8 text-center shadow-sm">
        <div class="w-14 h-14 rounded-2xl bg-error-container text-on-error-container grid place-items-center mx-auto"><span class="material-symbols-outlined text-3xl">lock</span></div>
        <h1 class="font-headline-lg text-headline-lg mt-5">No tienes permiso para esta sección</h1>
        <p class="text-on-surface-variant mt-2">El cargo asociado a tu cuenta no tiene activo el permiso requerido. Si crees que es un error, consulta al administrador del hotel.</p>
        <div class="flex flex-wrap justify-center gap-3 mt-6">
            @if (User.IsInRole(CargosSistema.Admin)) { <a asp-page="/Index" class="px-4 py-2 rounded-lg bg-primary text-on-primary font-semibold">Ir al panel</a> }
            @if (User.IsInRole(CargosSistema.Trabajador)) { <a asp-page="/Reservas/Index" class="px-4 py-2 rounded-lg bg-primary text-on-primary font-semibold">Ver reservas</a> }
            @if (User.IsInRole(CargosSistema.Huesped)) { <a asp-page="/Portal/Index" class="px-4 py-2 rounded-lg bg-primary text-on-primary font-semibold">Mis reservas</a> }
            @if (!User.IsInRole(CargosSistema.Huesped)) { <a asp-page="/Habitaciones/Index" class="px-4 py-2 rounded-lg bg-surface-container">Ver habitaciones</a> }
        </div>
    </section>
</main>
