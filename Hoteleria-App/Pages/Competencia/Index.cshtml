@page
@model Hoteleria_App.Pages.Competencia.IndexModel
@{
    ViewData["Title"] = "Tarifas de la competencia";
    string Dinero(decimal? valor) => valor is decimal v ? "$" + v.ToString("N0") : "—";
    string Clase(decimal? d) => d is null ? "text-outline" : d > 5 ? "text-error" : d < -5 ? "text-on-tertiary-container" : "text-on-surface";
    string Diferencia(decimal? d) => d is null ? "Sin datos" : d == 0 ? "Igual" : $"{Math.Abs(d.Value):0.#} % {(d > 0 ? "más caro" : "más barato")}";
    var entrada = Model.Entrada?.ToString("yyyy-MM-dd");
}
<main class="flex w-full flex-col gap-6">
    <section class="flex flex-wrap items-end justify-between gap-3">
        <div>
            <span class="font-label-sm uppercase tracking-wider text-secondary font-bold">ADMINISTRACIÓN · INTELIGENCIA DE MERCADO</span>
            <h1 class="font-headline-lg text-headline-lg mt-1">Tarifas de la competencia</h1>
            <p class="text-on-surface-variant max-w-3xl">Compare sus precios con lo que un cliente vería hoy en internet. Solo informa: ningún precio cambia por sí solo.</p>
        </div>
        <span class="rounded-lg bg-surface-container px-3 py-2 text-sm text-on-surface-variant"><strong class="text-on-surface">@Model.BusquedasDelMes</strong> de @Model.LimiteMensual búsquedas este mes</span>
    </section>

    <partial name="_Mensajes" />

    @if (!Model.Disponible)
    {
        <p class="rounded-xl bg-secondary-fixed p-4 text-on-secondary-fixed">La comparación está desactivada porque falta <code>SERPAPI_API_KEY</code>. El resto del sistema funciona con normalidad.</p>
    }

    <form method="post" asp-page-handler="Consultar" class="grid grid-cols-2 items-end gap-3 rounded-2xl border border-surface-container-high bg-surface-container-lowest p-4 md:grid-cols-5">
        <label class="col-span-2 flex flex-col gap-1 text-xs font-medium md:col-span-1">Ciudad
            <input name="Ciudad" value="@Model.Ciudad" maxlength="60" required class="rounded-lg border border-outline-variant/60 bg-surface-container-lowest px-3 py-2 text-sm font-normal" />
        </label>
        <label class="flex flex-col gap-1 text-xs font-medium">Entrada
            <input type="date" name="Entrada" value="@entrada" min="@Model.Hoy.ToString("yyyy-MM-dd")" required class="rounded-lg border border-outline-variant/60 bg-surface-container-lowest px-3 py-2 text-sm font-normal" />
        </label>
        <label class="flex flex-col gap-1 text-xs font-medium">Noches
            <input type="number" name="Noches" value="@Model.Noches" min="1" max="30" required class="rounded-lg border border-outline-variant/60 bg-surface-container-lowest px-3 py-2 text-sm font-normal" />
        </label>
        <label class="flex flex-col gap-1 text-xs font-medium">Adultos
            <input type="number" name="Adultos" value="@Model.Adultos" min="1" max="8" required class="rounded-lg border border-outline-variant/60 bg-surface-container-lowest px-3 py-2 text-sm font-normal" />
        </label>
        <button type="submit" disabled="@(!Model.Disponible)" onclick="this.form.addEventListener('submit',()=>{this.disabled=true;this.textContent='Consultando…'},{once:true})" class="col-span-2 flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-on-primary disabled:opacity-50 md:col-span-1">
            <span class="material-symbols-outlined text-[18px]">query_stats</span>Consultar precios
        </button>
        <small class="col-span-2 text-[11px] text-outline md:col-span-5">Cada consulta nueva gasta 1 búsqueda de SerpApi. Si la misma se hizo hace menos de 6 horas, se reutiliza sin gastar. Abrir esta página no gasta nada.</small>
    </form>

    @if (Model.Guardada is { } guardada)
    {
        <section class="flex flex-col gap-3">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h2 class="font-headline-sm text-headline-sm">Sus precios frente al mercado</h2>
                <small class="text-xs text-outline">Consulta del @guardada.Consulta.RealizadaEn.ToString("dd/MM/yyyy HH:mm") UTC · @guardada.Hoteles.Count hoteles · por noche, en USD</small>
            </div>
            <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                <div class="rounded-2xl border border-surface-container-high bg-surface-container-lowest p-4"><span class="text-sm text-outline">Media de sus competidores (@Model.CompetidoresConPrecio con precio)</span><strong class="mt-1 block text-3xl">@Dinero(Model.MediaCompetidores)</strong></div>
                <div class="rounded-2xl border border-surface-container-high bg-surface-container-lowest p-4"><span class="text-sm text-outline">Mediana de todo el mercado consultado</span><strong class="mt-1 block text-3xl">@Dinero(Model.MedianaMercado)</strong></div>
            </div>
            <div class="overflow-x-auto rounded-2xl border border-surface-container-high bg-surface-container-lowest">
                <table class="w-full text-left text-sm">
                    <thead class="bg-surface-container-low text-xs uppercase text-outline"><tr><th class="p-3">Su categoría</th><th class="p-3">Habitación comparada</th><th class="p-3 text-right">Su precio</th><th class="p-3">Frente a competidores</th><th class="p-3">Frente al mercado</th></tr></thead>
                    <tbody class="divide-y divide-surface-container">
                        @if (!Model.Comparacion.Any()) { <tr><td colspan="5" class="p-6 text-center text-outline">Ninguna habitación propia aloja a @Model.Adultos adulto(s).</td></tr> }
                        @foreach (var c in Model.Comparacion)
                        {
                            <tr>
                                <td class="p-3 font-semibold">@c.Categoria</td>
                                <td class="p-3 text-on-surface-variant">@c.Camas cama(s)</td>
                                <td class="p-3 text-right font-semibold">@Dinero(c.PrecioNoche)</td>
                                <td class="p-3 font-semibold @Clase(c.FrenteACompetidores)">@(c.FrenteACompetidores is null ? "Elija competidores abajo" : Diferencia(c.FrenteACompetidores))</td>
                                <td class="p-3 font-semibold @Clase(c.FrenteAlMercado)">@Diferencia(c.FrenteAlMercado)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <small class="text-xs text-outline">Referencia orientativa: sus categorías no equivalen exactamente a las de otros hoteles. Los precios pueden variar según agencia e impuestos. Se asume que sus tarifas están en USD.</small>
        </section>

        <section class="flex flex-col gap-3">
            <h2 class="font-headline-sm text-headline-sm">Hoteles encontrados</h2>
            @if (!Model.Ordenados.Any())
            {
                <p class="rounded-2xl border border-surface-container-high bg-surface-container-lowest p-8 text-center text-outline">No se encontraron hoteles para esos criterios.</p>
            }
            else
            {
                <div class="overflow-x-auto rounded-2xl border border-surface-container-high bg-surface-container-lowest">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-surface-container-low text-xs uppercase text-outline"><tr><th class="p-3">Hotel</th><th class="p-3">Valoración</th><th class="p-3 text-right">Desde, por noche</th><th class="p-3">Agencias</th><th class="p-3 text-right">Competidor</th></tr></thead>
                        <tbody class="divide-y divide-surface-container">
                            @foreach (var h in Model.Ordenados)
                            {
                                var seguido = Model.EsSeguido(h.Token);
                                <tr class="@(seguido ? "bg-secondary-fixed/20" : "")">
                                    <td class="p-3 font-semibold">
                                        @if (h.Enlace is not null) { <a href="@h.Enlace" target="_blank" rel="noopener noreferrer" class="hover:underline">@h.Nombre</a> } else { @h.Nombre }
                                        @if (h.Estrellas is not null) { <small class="block font-normal text-outline">@h.Estrellas estrellas</small> }
                                    </td>
                                    <td class="p-3 text-on-surface-variant">@(h.Calificacion is double nota ? $"{nota:0.0} ({h.Resenas ?? 0} reseñas)" : "—")</td>
                                    <td class="p-3 text-right font-semibold">@(h.PrecioNoche is null ? "Sin precio" : Dinero(h.PrecioNoche))</td>
                                    <td class="p-3 text-xs text-on-surface-variant">@(h.Agencias.Any() ? string.Join(" · ", h.Agencias.OrderBy(a => a.Precio).Take(3).Select(a => $"{a.Fuente} {Dinero(a.Precio)}")) : "—")</td>
                                    <td class="p-3 text-right">
                                        <form method="post" asp-page-handler="@(seguido ? "Dejar" : "Seguir")">
                                            <input type="hidden" name="token" value="@h.Token" />
                                            <input type="hidden" name="Ciudad" value="@Model.Ciudad" /><input type="hidden" name="Entrada" value="@entrada" /><input type="hidden" name="Noches" value="@Model.Noches" /><input type="hidden" name="Adultos" value="@Model.Adultos" />
                                            <button type="submit" class="rounded-lg px-3 py-1.5 text-xs font-semibold @(seguido ? "bg-secondary-container text-on-secondary-container" : "bg-surface-container text-on-surface hover:bg-surface-container-high")">@(seguido ? "Dejar de seguir" : "Seguir")</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @{
                var ausentes = Model.Competidores.Where(c => !guardada.Hoteles.Any(h => h.Token == c.PropertyToken)).ToList();
            }
            @if (ausentes.Any())
            {
                <div class="flex flex-col gap-2 rounded-xl bg-surface-container-low p-3 text-sm text-on-surface-variant">
                    <span>Competidores que no aparecieron en esta consulta, por lo que no cuentan en la media:</span>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var c in ausentes)
                        {
                            <form method="post" asp-page-handler="Dejar" class="flex items-center gap-2 rounded-lg bg-surface-container-lowest px-3 py-1.5">
                                <span class="font-semibold text-on-surface">@c.Nombre</span>
                                <input type="hidden" name="token" value="@c.PropertyToken" />
                                <input type="hidden" name="Ciudad" value="@Model.Ciudad" /><input type="hidden" name="Entrada" value="@entrada" /><input type="hidden" name="Noches" value="@Model.Noches" /><input type="hidden" name="Adultos" value="@Model.Adultos" />
                                <button type="submit" class="text-xs font-semibold text-error hover:underline">Quitar</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </section>
    }
    else
    {
        <p class="rounded-2xl border border-surface-container-high bg-surface-container-lowest p-10 text-center text-outline">Aún no hay datos para estos criterios. Pulse «Consultar precios».</p>
    }

    @if (Model.Historial.Any())
    {
        <section class="flex flex-col gap-3">
            <h2 class="font-headline-sm text-headline-sm">Historial de @Model.Ciudad</h2>
            <div class="overflow-x-auto rounded-2xl border border-surface-container-high bg-surface-container-lowest">
                <table class="w-full text-left text-sm">
                    <thead class="bg-surface-container-low text-xs uppercase text-outline"><tr><th class="p-3">Consultado (UTC)</th><th class="p-3">Estancia</th><th class="p-3">Adultos</th><th class="p-3 text-right">Media de competidores</th><th class="p-3 text-right">Mediana del mercado</th></tr></thead>
                    <tbody class="divide-y divide-surface-container">
                        @foreach (var p in Model.Historial)
                        {
                            <tr>
                                <td class="p-3 tabular-nums">@p.RealizadaEn.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="p-3 tabular-nums">@p.Entrada.ToString("dd/MM/yyyy") · @p.Noches noche(s)</td>
                                <td class="p-3 tabular-nums">@p.Adultos</td>
                                <td class="p-3 text-right tabular-nums">@Dinero(p.MediaCompetidores)</td>
                                <td class="p-3 text-right tabular-nums">@Dinero(p.MedianaMercado)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</main>
