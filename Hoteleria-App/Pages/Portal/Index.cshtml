@page
@model Hoteleria_App.Pages.Portal.IndexModel
@using Hoteleria_App.Models
@{
    ViewData["Title"] = "Mis reservas";
}
<main class="flex flex-col gap-6 w-full">
    <section class="bg-primary-container text-on-primary rounded-2xl p-6 md:p-8 flex flex-col md:flex-row md:items-end md:justify-between gap-5 shadow-sm">
        <div><span class="text-xs uppercase tracking-[.18em] text-primary-fixed-dim">GRANDSTAY · MI CUENTA</span><h1 class="font-headline-lg text-headline-lg mt-2">Mis reservas</h1><p class="text-on-primary/70 mt-1">Consulte sus estancias o reserve una nueva.</p></div>
        <div class="flex flex-wrap gap-2">
            <a asp-page="Perfil" class="px-4 py-2.5 rounded-lg bg-surface-container-lowest/10 text-on-primary">Mis datos</a>
            <a asp-page="Reservar" class="px-4 py-2.5 rounded-lg bg-secondary-container text-on-secondary-container font-semibold">Reservar habitación</a>
        </div>
    </section>
    <partial name="_Mensajes" />
    <section class="bg-surface-container-lowest border border-surface-container-high rounded-2xl overflow-hidden">
        <div class="overflow-x-auto"><table class="w-full text-left text-sm">
            <thead class="bg-surface-container-low text-outline uppercase text-xs"><tr><th class="p-3">Reserva</th><th class="p-3">Estado</th><th class="p-3">Estancia</th><th class="p-3">Habitaciones</th><th class="p-3 text-right">Total</th><th class="p-3"></th></tr></thead>
            <tbody class="divide-y divide-surface-container">
            @if (!Model.Reservas.Any()) { <tr><td colspan="6" class="p-10 text-center text-outline">Todavía no tiene reservas.</td></tr> }
            @foreach (var r in Model.Reservas)
            {
                <tr>
                    <td class="p-3 font-mono">#@r.ReservaId</td>
                    <td class="p-3"><span class="px-2.5 py-1 rounded-full text-xs font-semibold @r.BadgeEstado">@r.EstadoEtiqueta</span></td>
                    <td class="p-3">@r.InicioReserva.ToString("dd/MM/yyyy") – @r.FinReserva.ToString("dd/MM/yyyy")<small class="block text-outline">@r.TotalNoches noche(s)</small></td>
                    <td class="p-3">@r.TotalHabitaciones</td>
                    <td class="p-3 text-right font-semibold">$@r.PrecioTotal.ToString("N0")</td>
                    <td class="p-3 text-right flex justify-end items-center gap-4">
                        <a asp-page="Detalle" asp-route-id="@r.ReservaId" class="text-secondary font-semibold hover:underline">Ver detalle</a>
                        @if (EstadosReserva.Editable(r.EstadoReserva))
                        {
                            <form method="post" asp-page-handler="Cancelar" asp-route-id="@r.ReservaId" onsubmit="return confirm('¿Cancelar esta reserva?')"><button type="submit" class="text-error font-semibold hover:underline">Cancelar</button></form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table></div>
    </section>
</main>
