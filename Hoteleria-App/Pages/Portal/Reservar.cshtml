@page
@model Hoteleria_App.Pages.Portal.ReservarModel
@using Hoteleria_App.Services
@{
    ViewData["Title"] = "Reservar habitación";
}
<main class="flex w-full max-w-5xl flex-col gap-6">
    <section><span class="font-label-sm uppercase tracking-wider text-secondary font-bold">GRANDSTAY · RESERVAS</span><h1 class="font-headline-lg text-headline-lg mt-1">Reservar habitación</h1><p class="text-on-surface-variant">Indique las fechas y cuántas personas viajan: le mostramos las habitaciones libres que encajan.</p></section>
    <form method="post" class="flex flex-col gap-4 rounded-2xl border border-surface-container-high bg-surface-container-lowest p-4">
        <div asp-validation-summary="ModelOnly" class="rounded-xl bg-error-container text-on-error-container p-3 empty:hidden [&.validation-summary-valid]:hidden"></div>
        <div class="grid grid-cols-2 gap-2">
            <label class="flex flex-col gap-1 text-xs font-medium text-on-surface">Entrada
                <input id="portal-inicio" type="date" name="Inicio" value="@Model.Inicio?.ToString("yyyy-MM-dd")" min="@Model.Hoy.ToString("yyyy-MM-dd")" required class="w-full rounded-lg border border-outline-variant/60 bg-surface-container-lowest px-3 py-2 text-sm font-normal" />
            </label>
            <label class="flex flex-col gap-1 text-xs font-medium text-on-surface">Noches
                <input id="portal-noches" type="number" name="Noches" value="@Model.Noches" min="1" max="365" required class="w-full rounded-lg border border-outline-variant/60 bg-surface-container-lowest px-3 py-2 text-sm font-normal" />
            </label>
        </div>
        <partial name="_SelectorHabitaciones" model='new SelectorHabitacionesVista("HabitacionIds", "#portal-inicio", "#portal-noches", Model.HabitacionIds)' />
        <div class="flex items-center justify-between gap-3 border-t border-surface-container-high pt-3">
            <span class="text-sm text-on-surface-variant"><span id="selected-room-count">0</span> habitación(es) · Total <strong id="reservation-estimate" class="text-on-surface">S/ 0.00</strong></span>
            <button type="submit" class="rounded-lg bg-primary px-5 py-2 font-semibold text-on-primary">Confirmar reserva</button>
        </div>
    </form>
</main>
