# ============================================================================
# Configuración crítica del proyecto (contenedor SQL Server + app .NET)
# Copia este archivo a `.env` y ajusta los valores. `.env` NO se commitea
# (contiene credenciales); este `.env.example` sí se versiona como referencia.
# ============================================================================

# --- Imagen / edición de SQL Server (contenedor Docker) ---
MSSQL_IMAGE_TAG=2022-latest
MSSQL_PID=Developer
MSSQL_PORT=1433

# --- Credenciales compartidas (contenedor SQL Server + app .NET) ---
# La app (Program.cs) también lee DB_SERVER / DB_NAME / DB_USER / DB_PASSWORD /
# DB_TRUST_CERT como variables de entorno (o `dotnet user-secrets`).
DB_USER=sa
DB_PASSWORD=YourStrong@Passw0rd
DB_NAME=HOTEL
DB_SERVER=localhost,1433
DB_TRUST_CERT=true

# true -> la app usa base de datos real; false -> front-end con datos mock (sin BD).
DB_ENABLED=true

# true  -> la app aplica migraciones EF + semilla al arrancar (usa docker-compose.yml).
# false -> la BD ya se aprovisiona con el Dockerfile de Resources/DDBB/ (init-docker.sql).
DB_AUTO_MIGRATE=true

# Nota: si cambias MSSQL_PORT, actualiza también DB_SERVER (ej. localhost,14333).
