# ============================================================================
# Copia este archivo a `.env` y cambia cada valor. `.env` no se versiona.
# Estos valores son marcadores: la app no trae contraseñas por defecto.
# ============================================================================

# --- Base de datos local (docker compose) ---
POSTGRES_USER=hotel
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=hotel
POSTGRES_PORT=5432

# --- Conexión para ejecutar la app fuera de Docker con `dotnet run` ---
# En Compose y en Render se configura sola.
# Usa los mismos datos de arriba. Si la clave tiene símbolos, escríbelos con formato URL.
DATABASE_URL=postgres://hotel:cambia-esta-clave@localhost:5432/hotel

# --- Dominio único de los correos de acceso ---
# Al cambiarlo, las cuentas se convierten al arrancar y conservan su contraseña.
DOMINIO_CORREO=grandstay.com

# --- Administrador inicial ---
# Solo se usa si no existe ningún administrador. Después, cambia sus datos desde la app.
ADMIN_EMAIL=admin@grandstay.com
ADMIN_PASSWORD=Cambia-Esta-Clave-1

# --- Puerto local de la app ---
APP_PORT=5003

# --- Zona horaria del hotel (identificador IANA) ---
HOTEL_TIMEZONE=America/Lima

# true -> aplica migraciones y crea datos de referencia al arrancar.
DB_AUTO_MIGRATE=true

# --- Cuentas de demostración (opcional, para probar cada cargo) ---
# Nunca actives esto en un entorno publicado con claves conocidas.
DEMO_ACCOUNTS=false
DEMO_WORKER_EMAIL=trabajador@grandstay.com
DEMO_WORKER_PASSWORD=Cambia-Esta-Clave-2
DEMO_USER_EMAIL=huesped@grandstay.com
DEMO_USER_PASSWORD=Cambia-Esta-Clave-3

# --- Redis (opcional): caché de permisos y SignalR entre instancias ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Algolia (opcional): sin estas claves, la búsqueda usa PostgreSQL ---
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
ALGOLIA_INDEX=hoteleria_habitaciones

# --- Anthropic (opcional): sin esta clave, el copiloto y el asistente quedan desactivados ---
ANTHROPIC_API_KEY=
# Mensajes diarios del asistente del huésped, para proteger el saldo (valores por defecto: 15 y 50).
# ASISTENTE_LIMITE_USUARIO=15
# ASISTENTE_LIMITE_DIARIO=50
