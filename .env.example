# ============================================================================
# Configuración crítica del proyecto (contenedor SQL Server + app .NET)
# Copia este archivo a `.env` y ajusta los valores. `.env` NO se commitea
# (contiene credenciales); este `.env.example` sí se versiona como referencia.
# ============================================================================

# --- Imagen / edición de SQL Server (contenedor Docker) ---
MSSQL_IMAGE_TAG=2022-latest
MSSQL_PID=Developer
MSSQL_PORT=1433

# --- Credenciales compartidas (contenedor SQL Server + app .NET) ---
# La app (Program.cs) también lee DB_SERVER / DB_NAME / DB_USER / DB_PASSWORD /
# DB_TRUST_CERT como variables de entorno (o `dotnet user-secrets`).
DB_USER=sa
DB_PASSWORD=YourStrong@Passw0rd
DB_NAME=HOTEL
DB_SERVER=localhost,1433
DB_TRUST_CERT=true

# true  -> la app aplica migraciones pendientes y crea roles/empleado/admin al arrancar.
# Usa true también con el esquema preaprovisionado: el sembrado crea la cuenta de acceso.
DB_AUTO_MIGRATE=true

# Cuenta de acceso del administrador (Identity, se crea al arrancar si no existe)
ADMIN_EMAIL=admin@hoteleria.com
ADMIN_PASSWORD=Admin123!

# Cuentas de demostración para probar los permisos de cada cargo
DEMO_WORKER_EMAIL=trabajador@hoteleria.com
DEMO_WORKER_PASSWORD=Worker123!
DEMO_USER_EMAIL=usuario@hoteleria.com
DEMO_USER_PASSWORD=User123!

# Nota: si cambias MSSQL_PORT, actualiza también DB_SERVER (ej. localhost,14333).
